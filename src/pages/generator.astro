---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Cathedral Generator | Covenant Foundry"
	description="A seeded SVG generator for Covenant Foundry cathedral-style line art."
>
	<section class="generator-page" aria-labelledby="generator-title">
		<header class="generator-heading">
			<div>
				<p class="breadcrumb">Design System / Generator</p>
				<h1 id="generator-title">Cathedral Generator</h1>
			</div>
			<div class="generator-actions">
				<button class="plate-button small" type="button" id="randomize-seed">Randomize</button>
				<button class="plate-button small secondary" type="button" id="download-svg">Export SVG</button>
			</div>
		</header>

		<div class="generator-workbench">
			<section class="generator-preview-shell" aria-label="Generated artwork preview">
				<div class="generator-preview" id="art-preview"></div>
			</section>

			<aside class="generator-controls" aria-label="Generator controls">
				<label>
					<span>Seed</span>
					<input id="seed-input" name="seed" type="text" autocomplete="off" />
				</label>
				<div class="generator-control-row">
					<button class="plate-button small secondary" type="button" id="previous-seed">Previous</button>
					<button class="plate-button small secondary" type="button" id="next-seed">Next</button>
				</div>
				<label>
					<span>Target</span>
					<select id="target-input" name="target"></select>
				</label>
				<label>
					<span>Density <output id="density-value">6</output></span>
					<input id="density-input" name="density" type="range" min="1" max="10" value="6" />
				</label>
				<label>
					<span>Layers <output id="layers-value">5</output></span>
					<input id="layers-input" name="layers" type="range" min="2" max="8" value="5" />
				</label>
				<label>
					<span>Accent <output id="accent-value">5</output></span>
					<input id="accent-input" name="accent" type="range" min="1" max="10" value="5" />
				</label>
				<label>
					<span>Palette</span>
					<select id="palette-input" name="palette">
						<option value="foundry">Foundry</option>
						<option value="brass">Brass</option>
						<option value="ember">Ember</option>
						<option value="teal">Teal</option>
					</select>
				</label>
				<button class="plate-button small secondary" type="button" id="copy-seed">Copy Seed</button>
			</aside>
		</div>

		<section class="generator-gallery-shell" aria-label="Generated target sizes">
			<div class="frame-title">Target Sizes</div>
			<div class="generator-gallery target-gallery" id="target-gallery"></div>
		</section>
	</section>

	<script>
		const PHI = (1 + Math.sqrt(5)) / 2;
		const SQRT2 = Math.SQRT2;
		const SVG_NS = "http://www.w3.org/2000/svg";
		const LINE_WIDTH = {
			normal: 1.5,
			thick: 2,
		};

		const targets = [
			{ id: "site-desktop", label: "Site Desktop", width: 1920, height: 640, ratio: "3:1", frameInset: 56, corner: 40 },
			{ id: "site-mobile", label: "Site Mobile", width: 1080, height: 1350, ratio: "4:5", frameInset: 64, corner: 48 },
			{ id: "og-share", label: "OG / Share", width: 1200, height: 630, ratio: "1.91:1", frameInset: 44, corner: 34 },
			{ id: "x-header", label: "X Header", width: 1500, height: 500, ratio: "3:1", frameInset: 44, corner: 32 },
			{ id: "youtube-banner", label: "YouTube", width: 2560, height: 1440, ratio: "16:9", frameInset: 82, corner: 56 },
			{ id: "discord-banner", label: "Discord", width: 1920, height: 1080, ratio: "16:9", frameInset: 72, corner: 52 },
			{ id: "github-preview", label: "GitHub", width: 1280, height: 640, ratio: "2:1", frameInset: 48, corner: 36 },
			{ id: "linkedin-profile", label: "LinkedIn Profile", width: 1584, height: 396, ratio: "4:1", frameInset: 34, corner: 24 },
			{ id: "linkedin-page", label: "LinkedIn Page", width: 1128, height: 191, ratio: "5.9:1", frameInset: 18, corner: 14 },
		];

		const targetMap = Object.fromEntries(targets.map((target) => [target.id, target]));

		const palettes = {
			foundry: {
				background: "#080807",
				panel: "#10120f",
				grid: "rgba(242,236,220,0.06)",
				brass: "#b58a45",
				brassDim: "rgba(181,138,69,0.32)",
				ivory: "#f2ecdc",
				orange: "#f47f16",
				teal: "#73bbb8",
			},
			brass: {
				background: "#090907",
				panel: "#12110d",
				grid: "rgba(244,224,184,0.055)",
				brass: "#d0a45d",
				brassDim: "rgba(208,164,93,0.3)",
				ivory: "#f7ead2",
				orange: "#ec8324",
				teal: "#86b9ae",
			},
			ember: {
				background: "#0a0807",
				panel: "#130e0b",
				grid: "rgba(255,210,170,0.05)",
				brass: "#b9823e",
				brassDim: "rgba(185,130,62,0.3)",
				ivory: "#f3e7d6",
				orange: "#ff7a18",
				teal: "#76aaa6",
			},
			teal: {
				background: "#070909",
				panel: "#0c1111",
				grid: "rgba(208,238,232,0.05)",
				brass: "#ad8c52",
				brassDim: "rgba(173,140,82,0.28)",
				ivory: "#eef2e9",
				orange: "#f47f16",
				teal: "#7ac7c1",
			},
		};

		const state = {
			seed: "foundry-001",
			target: "site-desktop",
			density: 6,
			layers: 5,
			accent: 5,
			palette: "foundry",
			svg: "",
		};

		const elements = {
			preview: document.querySelector("#art-preview"),
			gallery: document.querySelector("#target-gallery"),
			seed: document.querySelector("#seed-input"),
			target: document.querySelector("#target-input"),
			density: document.querySelector("#density-input"),
			layers: document.querySelector("#layers-input"),
			accent: document.querySelector("#accent-input"),
			palette: document.querySelector("#palette-input"),
			densityValue: document.querySelector("#density-value"),
			layersValue: document.querySelector("#layers-value"),
			accentValue: document.querySelector("#accent-value"),
			randomize: document.querySelector("#randomize-seed"),
			previous: document.querySelector("#previous-seed"),
			next: document.querySelector("#next-seed"),
			download: document.querySelector("#download-svg"),
			copy: document.querySelector("#copy-seed"),
		};

		function hashString(input) {
			let hash = 2166136261;
			for (let index = 0; index < input.length; index += 1) {
				hash ^= input.charCodeAt(index);
				hash = Math.imul(hash, 16777619);
			}
			return hash >>> 0;
		}

		function createRandom(seed) {
			let value = hashString(seed);
			return () => {
				value += 0x6d2b79f5;
				let next = value;
				next = Math.imul(next ^ (next >>> 15), next | 1);
				next ^= next + Math.imul(next ^ (next >>> 7), next | 61);
				return ((next ^ (next >>> 14)) >>> 0) / 4294967296;
			};
		}

		function range(random, min, max) {
			return min + (max - min) * random();
		}

		function pick(random, values) {
			return values[Math.floor(random() * values.length)];
		}

		function snap(value, grid) {
			return Math.round(value / grid) * grid;
		}

		function clamp(value, min, max) {
			return Math.min(max, Math.max(min, value));
		}

		function escapeXml(value) {
			return String(value)
				.replaceAll("&", "&amp;")
				.replaceAll("<", "&lt;")
				.replaceAll(">", "&gt;")
				.replaceAll('"', "&quot;");
		}

		function pathFromPoints(points) {
			return points
				.map(([x, y], index) => `${index === 0 ? "M" : "L"} ${x} ${y}`)
				.join(" ");
		}

		function mirrored(content, width) {
			return `${content}<g transform="translate(${width} 0) scale(-1 1)">${content}</g>`;
		}

		function strokePath(d, className = "brass", width = LINE_WIDTH.normal, extra = "") {
			return `<path class="${className}" d="${d}" stroke-width="${width}" ${extra}/>`;
		}

		function terminal(x, y, radius = 3, className = "brass", strokeWidth = LINE_WIDTH.normal) {
			const fillRadius = Math.max(1.2, radius / 2.3);
			return `<circle class="${className}" cx="${x}" cy="${y}" r="${radius}" stroke-width="${strokeWidth}"/><circle class="${className}-fill" cx="${x}" cy="${y}" r="${fillRadius}"/>`;
		}

		function getTarget(targetId = state.target) {
			return targetMap[targetId] ?? targets[0];
		}

		function getTargetKind(target) {
			const aspect = target.width / target.height;
			return {
				isVertical: aspect < 1,
				isSlim: aspect > 3.6,
			};
		}

		function buildSvg(seed, options, target = getTarget(), compact = false) {
			const width = target.width;
			const height = target.height;
			const centerX = width / 2;
			const { isVertical, isSlim } = getTargetKind(target);
			const random = createRandom(
				`${seed}:${target.id}:${options.density}:${options.layers}:${options.accent}:${options.palette}`,
			);
			const forestRandom = createRandom(`${seed}:${target.id}:${options.palette}:side-forest`);
			const color = palettes[options.palette] ?? palettes.foundry;
			const grid = pick(random, isSlim ? [4, 6, 8] : [8, 10, 12, 16]);
			const uid = `cf-${hashString(seed + target.id + options.palette).toString(36)}`;
			const shortSide = Math.min(width, height);
			const frameInset = target.frameInset;
			const corner = target.corner;
			const frameBottomY = height - frameInset;
			const frameWidth = width - frameInset * 2;
			const frameHeight = height - frameInset * 2;
			const medallionRadius = clamp(shortSide * 0.035, 5, 22);
			const railY = frameBottomY - medallionRadius;
			const contentHeight = frameHeight / PHI;
			const contentWidth = Math.min(frameWidth / PHI, contentHeight * (16 / 9));
			const contentX = centerX - contentWidth / 2;
			const contentY = railY - contentHeight;
			const circleDiameter = contentWidth / PHI;
			const circleRadius = circleDiameter / 2;
			const circleAboveContent = (1 - 1 / PHI) * circleDiameter;
			const circleCenterY = contentY - circleAboveContent + circleRadius;
			const circleDyAtGuide = contentY - circleCenterY;
			const circleHalfChord = Math.sqrt(Math.max(0, circleRadius ** 2 - circleDyAtGuide ** 2));
			const circleArcLeftX = centerX - circleHalfChord;
			const circleArcRightX = centerX + circleHalfChord;
			const circleTopY = circleCenterY - circleRadius;
			const logoPlacementDiameter = circleDiameter / PHI;
			const logoGuideDiameter = logoPlacementDiameter / 2;
			const logoGuideRadius = logoGuideDiameter / 2;
			const logoGuideCenterY = contentY - logoPlacementDiameter / PHI + logoPlacementDiameter / 2;
			const logoGuideTopY = logoGuideCenterY - logoGuideRadius;
			const recessedLineY = logoGuideTopY;
			const recessedArcEndY = (logoGuideTopY + logoGuideCenterY) / 2;
			const recessedReferenceLineY = (circleTopY + logoGuideTopY) / 2;
			const recessedReferenceArcRun = (recessedArcEndY - recessedReferenceLineY) * PHI;
			const recessedShapeWidth = contentWidth + recessedReferenceArcRun * 2;
			const recessedLineWidth = recessedShapeWidth * (3 / 5);
			const recessedArcRun = recessedLineWidth / 6;
			const recessedLineStartX = centerX - recessedLineWidth / 2;
			const recessedLineEndX = centerX + recessedLineWidth / 2;
			const recessedArcDrop = recessedArcEndY - recessedLineY;
			const recessedStepCount = 2;
			const recessedStepSize = recessedArcDrop / recessedStepCount;
			const recessedLeadRun = recessedArcRun - recessedArcDrop;
			const recessedOuterArcEndX = recessedLineStartX - recessedArcRun;
			const recessedOuterStepStartX = recessedOuterArcEndX - recessedLeadRun;
			const recessedOuterWallX = recessedOuterStepStartX - recessedStepSize * recessedStepCount;
			const foregroundWallBottomY = railY - grid;
			const railEndOffset = grid * (frameWidth / frameHeight);
			const foregroundRailEndX = frameInset + corner + railEndOffset;
			const recessedInsetStep = recessedArcRun / 6;
			const traceCount = 6;
			const sideForestLineCount = 12;
			const sideForestGrid = Math.max(2, grid / 2);
			const sideForestWidth = contentWidth / 2;
			const sideForestAreaStartX = foregroundRailEndX;
			const sideForestAreaEndX = sideForestAreaStartX + sideForestWidth;
			const sideForestFits = sideForestAreaEndX <= recessedOuterWallX;
			const sideForestSpacing = sideForestFits
				? sideForestWidth / (sideForestLineCount - 1)
				: 0;
			const sideForestStartX = sideForestAreaStartX;
			const sideForestBaseY = foregroundWallBottomY;
			const sideForestMinHeight = Math.max(grid * 5, frameHeight * 0.14);
			const sideForestMaxHeight = Math.max(
				sideForestMinHeight + grid * 3,
				Math.min(frameHeight * 0.72, sideForestBaseY - (frameInset + corner * 0.9)),
			);
			const sideForestHeights = Array.from({ length: sideForestLineCount }, () =>
				snap(range(forestRandom, sideForestMinHeight, sideForestMaxHeight), sideForestGrid),
			);

			const framePaths = [];
			const centerPaths = [];
			const centerAccent = [];
			const recessedLayer = [];
				const logoGuide = [];
				const sideForestLeft = [];
				const sideForestCapsLeft = [];
				const sideForestMaskCutsLeft = [];
				const stepLeft = [];
				const traceLeft = [];
				const cornerGuides = [];
				const centerMarks = [];
				let foregroundShoulderPath = "";
				let foregroundRailLinePath = "";
			const foregroundStrokeWidth = LINE_WIDTH.normal;
			const foregroundTopMaskStrokeWidth = foregroundStrokeWidth + Math.max(2, grid * 0.25);
			const foregroundTopMaskPath = `M ${circleArcLeftX} ${contentY} A ${circleRadius} ${circleRadius} 0 0 1 ${circleArcRightX} ${contentY} Z`;

			framePaths.push(
				strokePath(
					`M ${frameInset + corner} ${frameInset} H ${width - frameInset - corner} L ${width - frameInset} ${frameInset + corner} V ${height - frameInset - corner} L ${width - frameInset - corner} ${height - frameInset} H ${frameInset + corner} L ${frameInset} ${height - frameInset - corner} V ${frameInset + corner} Z`,
					"brass",
					LINE_WIDTH.normal,
				),
			);
			centerPaths.push(
				strokePath(
					`M ${circleArcLeftX} ${contentY} A ${circleRadius} ${circleRadius} 0 0 1 ${circleArcRightX} ${contentY}`,
					"brass",
					LINE_WIDTH.normal,
				),
			);
				logoGuide.push(
					`<circle class="orange logo-guide" cx="${centerX}" cy="${logoGuideCenterY}" r="${logoGuideRadius}" stroke-width="${LINE_WIDTH.normal}"/>`,
				);
				const cornerGuideDotCount = 6;
				const cornerGuideSize = logoGuideDiameter;
				const cornerGuideSpacing = cornerGuideSize / (cornerGuideDotCount - 1);
				const cornerDecorStrokeWidth = LINE_WIDTH.thick;
				const sideForestCapRadius = Math.max(3, grid * 0.42);
				const shouldShowLeftCornerDot = (column, row) =>
					!(column === 0 && row === 0)
					&& !(column === 2 && row === 3)
					&& !(column === 3 && row === 2)
					&& column + row <= 5;
				function cornerCircuitGuide(transform) {
					const visibleNodes = [];
					const nodeX = (column) => column * cornerGuideSpacing;
					const nodeY = (row) => row * cornerGuideSpacing;
					const traceStrokeWidth = cornerDecorStrokeWidth;
					const terminalRadius = sideForestCapRadius;

					for (let row = 0; row < cornerGuideDotCount; row += 1) {
						for (let column = 0; column < cornerGuideDotCount; column += 1) {
							if (!shouldShowLeftCornerDot(column, row)) continue;
							visibleNodes.push({ column, row });
						}
					}

						const nodeSet = new Set(visibleNodes.map((node) => `${node.column},${node.row}`));
						const traceSegments = [];

						for (const { column, row } of visibleNodes) {
							if (nodeSet.has(`${column + 1},${row}`)) {
								traceSegments.push(`M ${nodeX(column)} ${nodeY(row)} H ${nodeX(column + 1)}`);
							}
							if (nodeSet.has(`${column},${row + 1}`)) {
								traceSegments.push(`M ${nodeX(column)} ${nodeY(row)} V ${nodeY(row + 1)}`);
							}
						}
						const terminals = [
							{ column: cornerGuideDotCount - 1, row: 0 },
							{ column: 0, row: cornerGuideDotCount - 1 },
						].filter((node) => nodeSet.has(`${node.column},${node.row}`));

						return `<g class="corner-circuit-guide" transform="${transform}">
							<path class="corner-trace" d="${traceSegments.join(" ")}" stroke-width="${traceStrokeWidth}"/>
							${terminals
								.map((node) => `<circle class="corner-terminal" cx="${nodeX(node.column)}" cy="${nodeY(node.row)}" r="${terminalRadius}" stroke-width="${traceStrokeWidth}"/>`)
								.join("")}
						</g>`;
				}
				const cornerGuideX = frameInset + cornerGuideSpacing;
				const cornerGuideY = frameInset + cornerGuideSpacing;
				const cornerGuideRightX = width - frameInset - cornerGuideSpacing - cornerGuideSize;
				cornerGuides.push(
					cornerCircuitGuide(`translate(${cornerGuideX} ${cornerGuideY})`),
					cornerCircuitGuide(`translate(${cornerGuideRightX + cornerGuideSize} ${cornerGuideY}) scale(-1 1)`),
				);
			function addRecessedShape(inset, className) {
				const lineY = recessedLineY + inset;
				const wallBottomY = foregroundWallBottomY;
				const lineStartX = recessedLineStartX + inset;
				const lineEndX = recessedLineEndX - inset;
				const arcEndX = lineStartX - recessedArcRun;
				const arcEndY = lineY + recessedArcDrop;
				const stepStartX = arcEndX - recessedLeadRun;
				const stairPath = Array.from({ length: recessedStepCount }, (_, index) => {
					const step = index + 1;
					const x = stepStartX - recessedStepSize * step;
					const y = arcEndY + recessedStepSize * step;
					return `V ${y} H ${x}`;
				}).join(" ");
				const strokeWidth = foregroundStrokeWidth;
				recessedLayer.push(strokePath(`M ${lineStartX} ${lineY} H ${lineEndX}`, className, strokeWidth));
				recessedLayer.push(
					mirrored(
						strokePath(
							`M ${lineStartX} ${lineY} A ${circleRadius} ${circleRadius} 0 0 0 ${arcEndX} ${arcEndY} H ${stepStartX} ${stairPath} V ${wallBottomY}`,
							className,
							strokeWidth,
						),
						width,
					),
				);
			}
			addRecessedShape(recessedInsetStep * 2, "brass-dim");
			addRecessedShape(recessedInsetStep, "brass-dim");
			addRecessedShape(0, "brass");
			for (let index = 0; sideForestFits && index < sideForestLineCount; index += 1) {
				const x = sideForestStartX + sideForestSpacing * index;
				const height = sideForestHeights[index];
				const y = sideForestBaseY - height;
				const isPeak = index > 0
					&& index < sideForestLineCount - 1
					&& height > sideForestHeights[index - 1]
					&& height > sideForestHeights[index + 1];
				const className = isPeak ? "orange" : "brass";
				const forestCenterIndex = (sideForestLineCount - 1) / 2;
				const forestCenterBand = sideForestLineCount % 2 === 0 ? 0.5 : 0;
				const forestMaxDistance = Math.max(1, forestCenterIndex - forestCenterBand);
				const forestDistance = Math.max(0, Math.abs(index - forestCenterIndex) - forestCenterBand);
					const opacity = 1 - (forestDistance / forestMaxDistance) * 0.5;
					const strokeWidth = cornerDecorStrokeWidth;
					const capRadius = sideForestCapRadius;
					const lineTopY = y;
				sideForestLeft.push(
					strokePath(
						`M ${x} ${sideForestBaseY} V ${lineTopY}`,
						className,
						strokeWidth,
						`opacity="${opacity.toFixed(3)}"`,
					),
				);
						if (isPeak) {
							const maskRadius = Math.ceil(capRadius + strokeWidth / 2);
							sideForestMaskCutsLeft.push(
								`<circle cx="${x}" cy="${y}" r="${maskRadius}" fill="#000"/>`,
							);
							sideForestCapsLeft.push(
								`<circle class="orange side-forest-cap" cx="${x}" cy="${y}" r="${capRadius}" stroke-width="${strokeWidth}" stroke-opacity="${opacity.toFixed(3)}"/>`,
							);
						}
			}
			const shoulderStep = contentWidth / 48;
			const shoulderBottomY = foregroundWallBottomY;
			const foregroundShoulderPoints = [
				[contentX, shoulderBottomY],
				[contentX, contentY + shoulderStep * 4],
				[contentX + shoulderStep, contentY + shoulderStep * 4],
				[contentX + shoulderStep, contentY + shoulderStep * 3],
				[contentX + shoulderStep * 2, contentY + shoulderStep * 3],
				[contentX + shoulderStep * 2, contentY + shoulderStep * 2],
				[contentX + shoulderStep * 3, contentY + shoulderStep * 2],
				[contentX + shoulderStep * 3, contentY + shoulderStep],
				[contentX + shoulderStep * 4, contentY + shoulderStep],
				[contentX + shoulderStep * 4, contentY],
				[circleArcLeftX, contentY],
			];
			foregroundShoulderPath = pathFromPoints(foregroundShoulderPoints);
			foregroundRailLinePath = `M ${contentX} ${foregroundWallBottomY} H ${foregroundRailEndX}`;
			stepLeft.push(
				strokePath(
					foregroundShoulderPath,
					"brass",
					foregroundStrokeWidth,
				),
			);
			stepLeft.push(
				strokePath(
					foregroundRailLinePath,
					"brass",
					foregroundStrokeWidth,
				),
			);
			centerPaths.push(
				strokePath(
					`M ${frameInset + corner} ${railY} H ${centerX - medallionRadius * 4.2} L ${centerX - medallionRadius * 2.7} ${railY + medallionRadius} H ${centerX + medallionRadius * 2.7} L ${centerX + medallionRadius * 4.2} ${railY} H ${width - frameInset - corner}`,
					"brass",
					LINE_WIDTH.normal,
				),
			);
			centerMarks.push(terminal(centerX, railY + medallionRadius, medallionRadius, "brass"));
			centerAccent.push(
				strokePath(
					`M ${centerX} ${railY} V ${railY + medallionRadius * 2} M ${centerX - medallionRadius} ${railY + medallionRadius} H ${centerX + medallionRadius}`,
					"orange",
					LINE_WIDTH.normal,
				),
			);

			const logoEndpointPadding = Math.max(2, grid * 0.6);
			const traceTopCandidate = Math.max(
				frameInset + corner,
				circleTopY + grid * 3,
				logoGuideCenterY - logoGuideRadius + logoEndpointPadding,
			);
			const traceBottomCandidate = Math.min(
				circleCenterY - grid * 1.5,
				contentY + contentHeight * 0.28,
				logoGuideCenterY + logoGuideRadius - logoEndpointPadding,
			);
			const traceTop = traceBottomCandidate - traceTopCandidate >= grid
				? traceTopCandidate
				: Math.max(logoGuideCenterY - logoGuideRadius + logoEndpointPadding, traceBottomCandidate - grid);
			const traceBottom = Math.max(traceTop + grid, traceBottomCandidate);
			const traceSpan = traceBottom - traceTop;
			const traceRows = Math.max(1, traceCount);
			const traceLaneGap = traceSpan / (traceRows + 1);
			const traceLaneYs = Array.from({ length: traceRows }, (_, index) => traceTop + traceLaneGap * (index + 1));
			const endpointRowStart = Math.ceil((traceTop + grid * 0.2) / grid) * grid;
			const endpointRowEnd = Math.floor((traceBottom - grid * 0.2) / grid) * grid;
			let endpointRows = [];
			for (let row = endpointRowStart; row <= endpointRowEnd + 0.001; row += grid) {
				endpointRows.push(row);
			}
			if (endpointRows.length < traceCount) {
				const fallbackGap = traceCount > 1 ? traceSpan / (traceCount - 1) : 0;
				endpointRows = Array.from({ length: traceCount }, (_, index) =>
					Number((traceTop + fallbackGap * index).toFixed(3)),
				);
			}
			const bendAmount = Math.max(grid * 0.65, Math.min(traceLaneGap * 0.38, grid * 2.4));
			const traceSeed = `${seed}:${target.id}:${options.density}:${options.layers}:${options.accent}:${options.palette}:traces`;
			const traceCandidateCount = compact ? 72 : 220;

			function arcLeftAt(y, padding = 0) {
				const half = Math.sqrt(Math.max(0, circleRadius ** 2 - (y - circleCenterY) ** 2));
				return centerX - half + padding;
			}

			function pointInsideCircle(x, y, radius = 0) {
				return (x - centerX) ** 2 + (y - circleCenterY) ** 2 <= (circleRadius - radius) ** 2 + 0.001;
			}

			function pointInsideLogoGuide(x, y) {
				return (x - centerX) ** 2 + (y - logoGuideCenterY) ** 2 <= logoGuideRadius ** 2 + 0.001;
			}

			function chooseEndpointLanes(candidateRandom) {
				const selectedRows = [];
				let previousEndpointIndex = -1;
				for (let index = 0; index < traceCount; index += 1) {
					const bendDirection = index % 2 === 0 ? 1 : -1;
					const preferredTerminalY = snap(traceLaneYs[index] + bendDirection * bendAmount, grid);
					const minIndex = previousEndpointIndex + 1;
					const maxIndex = endpointRows.length - (traceCount - index);
					const candidates = endpointRows.slice(minIndex, maxIndex + 1);
					const weightedRows = candidates.map((row, relativeIndex) => {
						const startCollisionPenalty = traceLaneYs.some((traceY) => Math.abs(traceY - row) <= 0.001) ? grid * 1.5 : 0;
						const edgePenalty = relativeIndex === 0 || relativeIndex === candidates.length - 1 ? grid * 0.2 : 0;
						const score = Math.abs(row - preferredTerminalY) + startCollisionPenalty + edgePenalty;
						return { row, relativeIndex, weight: 1 / (1 + score / grid) ** 3 };
					});
					const totalWeight = weightedRows.reduce((total, row) => total + row.weight, 0);
					let threshold = candidateRandom() * totalWeight;
					let chosen = weightedRows[0];
					for (const row of weightedRows) {
						threshold -= row.weight;
						if (threshold <= 0) {
							chosen = row;
							break;
						}
					}
					previousEndpointIndex = minIndex + chosen.relativeIndex;
					selectedRows.push(Number(chosen.row.toFixed(3)));
				}
				return selectedRows;
			}

			function scoreTraceCandidate(traces, endpointLaneYs) {
				let score = 0;
				const endpointGaps = endpointLaneYs.slice(1).map((row, index) => row - endpointLaneYs[index]);
				const idealEndpointGap = endpointGaps.reduce((total, gap) => total + gap, 0) / Math.max(1, endpointGaps.length);
				const traceLengths = [];

				for (const gap of endpointGaps) {
					score += ((gap - idealEndpointGap) / grid) ** 2 * 16;
					if (gap < grid * 0.8) score += (grid * 0.8 - gap) ** 2;
				}

				for (const trace of traces) {
					const startRun = trace.pathStartX - trace.mid;
					const endRun = trace.diagonalEndX - trace.pathEndX;
					const edgeClearance = trace.end - trace.terminalLeftBound - trace.endRadius;
					const totalLength = startRun + trace.diagonalRun * SQRT2 + endRun;
					traceLengths.push(totalLength);
					score += Math.max(0, grid * 1.6 - startRun) ** 2 * 0.7;
					score += Math.max(0, grid * 1.2 - endRun) ** 2 * 0.8;
					score += Math.max(0, grid * 0.7 - edgeClearance) ** 2 * 0.6;
					score += Math.abs(startRun - grid * 4.5) / grid;
					score += Math.abs(endRun - grid * 2.6) / grid;
					score += Math.abs(trace.diagonalRun - bendAmount) / grid * 0.55;
				}

				const meanLength = traceLengths.reduce((total, length) => total + length, 0) / Math.max(1, traceLengths.length);
				const lengthVariance = traceLengths.reduce((total, length) => total + (length - meanLength) ** 2, 0) / Math.max(1, traceLengths.length);
				score += lengthVariance / (grid ** 2) * 0.12;

				for (let first = 0; first < traces.length; first += 1) {
					for (let second = first + 1; second < traces.length; second += 1) {
						const firstTrace = traces[first];
						const secondTrace = traces[second];
						if (Math.abs(firstTrace.end - secondTrace.end) < grid * 0.7) {
							score += Math.max(0, grid * 1.4 - Math.abs(firstTrace.terminalY - secondTrace.terminalY));
						}
						if (Math.abs(firstTrace.mid - secondTrace.mid) < grid * 0.75) score += 1.5;
					}
				}

				return score;
			}

			function buildTraceCandidate(candidateIndex) {
				const candidateRandom = createRandom(`${traceSeed}:${candidateIndex}`);
				const endpointLaneYs = chooseEndpointLanes(candidateRandom);
				const traces = [];

				for (let index = 0; index < traceCount; index += 1) {
					const y = traceLaneYs[index];
					const terminalY = endpointLaneYs[index];
					const startRadius = isSlim ? 2 : candidateRandom() < 0.55 ? 3 : 4;
					const endRadius = isSlim ? 1.8 : 2.6;
					const logoHalfAtY = Math.sqrt(Math.max(0, logoGuideRadius ** 2 - (y - logoGuideCenterY) ** 2));
					const startMin = centerX - logoHalfAtY + Math.max(logoEndpointPadding, startRadius);
					const startMax = centerX - Math.max(logoEndpointPadding, startRadius);
					if (startMax <= startMin) return null;

					const start = clamp(
						snap(centerX - range(candidateRandom, logoHalfAtY * 0.38, logoHalfAtY * 0.84), grid),
						startMin,
						startMax,
					);
					if (!pointInsideLogoGuide(start, y) || !pointInsideCircle(start, y, startRadius)) return null;

					const traceLeftBound = arcLeftAt(y, grid * 2);
					const terminalLeftBound = arcLeftAt(terminalY, grid * 2 + endRadius);
					const diagonalRun = Math.abs(terminalY - y);
					const midMin = Math.max(traceLeftBound + grid * 1.4, terminalLeftBound + diagonalRun + grid * 1.2);
					const midMax = start - startRadius - grid * 1.1;
					if (midMax <= midMin) return null;

					const mid = clamp(snap(range(candidateRandom, midMin, midMax), grid), midMin, midMax);
					const diagonalEndX = mid - diagonalRun;
					const endMax = diagonalEndX - Math.max(grid, endRadius * 1.8);
					if (endMax <= terminalLeftBound) return null;

					const end = clamp(snap(range(candidateRandom, terminalLeftBound, endMax), grid), terminalLeftBound, endMax);
					if (!pointInsideCircle(end, terminalY, endRadius)) return null;

					const traceStrokeWidth = LINE_WIDTH.normal;
					const pathStartX = Math.max(mid, start - startRadius);
					const pathEndX = Math.min(diagonalEndX, end + endRadius);
					const points = [
						[pathStartX, y],
						[mid, y],
						[diagonalEndX, terminalY],
						[pathEndX, terminalY],
					];
					if (points.some(([x, pointY]) => !pointInsideCircle(x, pointY))) return null;

					traces.push({
						y,
						start,
						startRadius,
						mid,
						terminalY,
						end,
						endRadius,
						terminalLeftBound,
						diagonalRun,
						diagonalEndX,
						pathStartX,
						pathEndX,
						traceStrokeWidth,
					});
				}

				return {
					score: scoreTraceCandidate(traces, endpointLaneYs),
					traces,
				};
			}

			let bestTraceCandidate = null;
			for (let candidateIndex = 0; candidateIndex < traceCandidateCount; candidateIndex += 1) {
				const candidate = buildTraceCandidate(candidateIndex);
				if (!candidate) continue;
				if (!bestTraceCandidate || candidate.score < bestTraceCandidate.score) bestTraceCandidate = candidate;
			}

			for (const trace of bestTraceCandidate?.traces ?? []) {
				const d = `M ${trace.pathStartX} ${trace.y} H ${trace.mid} L ${trace.diagonalEndX} ${trace.terminalY} H ${trace.pathEndX}`;
				traceLeft.push(strokePath(d, "brass", trace.traceStrokeWidth));
				traceLeft.push(terminal(trace.start, trace.y, trace.startRadius, "brass"));
				traceLeft.push(terminal(trace.end, trace.terminalY, trace.endRadius, "brass"));
			}

			const textureOpacity = compact ? 0.48 : 0.78;
			const title = escapeXml(`Covenant Foundry ${target.label} cathedral line art ${seed}`);
			const panelX = contentX;
			const panelWidth = contentWidth;
			const panelY = contentY;
			const panelHeight = contentHeight;
			const glowCenterY = `${(logoGuideCenterY / height) * 100}%`;
			const glowRadius = isVertical ? "82%" : "72%";

			return `<svg xmlns="${SVG_NS}" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}" role="img" aria-labelledby="${uid}-title">
	<title id="${uid}-title">${title}</title>
	<defs>
		<pattern id="${uid}-grid" width="52" height="52" patternUnits="userSpaceOnUse">
			<path d="M 52 0 H 0 V 52" fill="none" stroke="${color.grid}" stroke-width="1"/>
		</pattern>
		<radialGradient id="${uid}-glow" cx="50%" cy="${glowCenterY}" r="${glowRadius}">
			<stop offset="0" stop-color="${color.orange}" stop-opacity="0.13"/>
			<stop offset="0.52" stop-color="${color.brass}" stop-opacity="0.055"/>
			<stop offset="1" stop-color="${color.background}" stop-opacity="0"/>
		</radialGradient>
		<clipPath id="${uid}-trace-clip" clipPathUnits="userSpaceOnUse">
			<path d="M ${centerX - circleRadius} ${circleCenterY} A ${circleRadius} ${circleRadius} 0 0 1 ${centerX + circleRadius} ${circleCenterY} L ${centerX - circleRadius} ${circleCenterY} Z"/>
		</clipPath>
		<mask id="${uid}-trace-mask" maskUnits="userSpaceOnUse">
			<rect width="${width}" height="${height}" fill="#fff"/>
			<circle cx="${centerX}" cy="${logoGuideCenterY}" r="${logoGuideRadius}" fill="#000"/>
		</mask>
		<mask id="${uid}-recessed-mask" maskUnits="userSpaceOnUse">
			<rect width="${width}" height="${height}" fill="#fff"/>
			<path d="${foregroundTopMaskPath}" fill="#000" stroke="#000" stroke-width="${foregroundTopMaskStrokeWidth}"/>
		</mask>
		<mask id="${uid}-side-forest-mask" maskUnits="userSpaceOnUse">
			<rect width="${width}" height="${height}" fill="#fff"/>
			${mirrored(sideForestMaskCutsLeft.join(""), width)}
		</mask>
		<style>
			#${uid}-art * { vector-effect: non-scaling-stroke; }
			#${uid}-art .brass,
			#${uid}-art .brass-dim,
			#${uid}-art .orange,
			#${uid}-art .teal { fill: none; stroke-linecap: square; stroke-linejoin: miter; }
			#${uid}-art .brass { stroke: ${color.brass}; }
			#${uid}-art .brass-dim { stroke: ${color.brassDim}; }
				#${uid}-art .orange { stroke: ${color.orange}; }
				#${uid}-art .teal { stroke: ${color.teal}; }
				#${uid}-art .brass-fill { fill: ${color.brass}; stroke: none; }
				#${uid}-art .orange-fill { fill: ${color.orange}; stroke: none; }
				#${uid}-art .corner-trace {
					fill: none;
					stroke: ${color.brass};
					stroke-linecap: round;
					stroke-linejoin: round;
				}
				#${uid}-art .corner-terminal {
					fill: ${color.background};
					stroke: ${color.brass};
				}
				#${uid}-art .side-forest-cap {
					fill: none;
				}
				#${uid}-art .guide-dot { fill: ${color.ivory}; opacity: 0.38; stroke: none; }
				#${uid}-art .panel { fill: ${color.panel}; opacity: 0.62; }
			</style>
	</defs>
	<g id="${uid}-art">
		<rect width="${width}" height="${height}" fill="${color.background}"/>
		<rect width="${width}" height="${height}" fill="url(#${uid}-grid)" opacity="${textureOpacity}"/>
		<rect width="${width}" height="${height}" fill="url(#${uid}-glow)"/>
			<g class="recessed-layer" mask="url(#${uid}-recessed-mask)">${recessedLayer.join("")}</g>
			<rect class="panel" x="${panelX}" y="${panelY}" width="${panelWidth}" height="${panelHeight}"/>
				<g class="corner-guides">${cornerGuides.join("")}</g>
				<g class="side-forest" mask="url(#${uid}-side-forest-mask)">${mirrored(sideForestLeft.join(""), width)}</g>
				<g class="side-forest-caps">${mirrored(sideForestCapsLeft.join(""), width)}</g>
		<g>${framePaths.join("")}${centerPaths.join("")}</g>
		<g>${mirrored(stepLeft.join(""), width)}</g>
		<g>${centerAccent.join("")}</g>
		<g clip-path="url(#${uid}-trace-clip)" mask="url(#${uid}-trace-mask)">${mirrored(traceLeft.join(""), width)}</g>
		<g>${logoGuide.join("")}</g>
		<g>${centerMarks.join("")}</g>
	</g>
</svg>`;
		}

		function populateTargets() {
			const fragment = document.createDocumentFragment();
			for (const target of targets) {
				const option = document.createElement("option");
				option.value = target.id;
				option.textContent = `${target.label} (${target.width} x ${target.height})`;
				fragment.append(option);
			}
			elements.target.replaceChildren(fragment);
		}

		function readControls() {
			state.seed = elements.seed.value.trim() || "foundry-001";
			state.target = elements.target.value || "site-desktop";
			state.density = Number(elements.density.value);
			state.layers = Number(elements.layers.value);
			state.accent = Number(elements.accent.value);
			state.palette = elements.palette.value;
		}

		function writeControls() {
			elements.seed.value = state.seed;
			elements.target.value = getTarget().id;
			elements.density.value = String(state.density);
			elements.layers.value = String(state.layers);
			elements.accent.value = String(state.accent);
			elements.palette.value = state.palette;
			elements.densityValue.value = String(state.density);
			elements.layersValue.value = String(state.layers);
			elements.accentValue.value = String(state.accent);
		}

		function updateUrl() {
			const url = new URL(window.location.href);
			url.searchParams.set("seed", state.seed);
			url.searchParams.set("target", getTarget().id);
			url.searchParams.set("density", String(state.density));
			url.searchParams.set("layers", String(state.layers));
			url.searchParams.set("accent", String(state.accent));
			url.searchParams.set("palette", state.palette);
			window.history.replaceState({}, "", url);
		}

		function renderTargets() {
			const fragment = document.createDocumentFragment();
			for (const target of targets) {
				const button = document.createElement("button");
				button.type = "button";
				button.className = "target-tile";
				button.dataset.target = target.id;
				button.style.setProperty("--tile-ratio", String(target.width / target.height));
				button.setAttribute("aria-label", `Use ${target.label} target`);
				button.innerHTML = `<span class="target-art">${buildSvg(state.seed, state, target, true)}</span><span class="target-meta"><strong>${target.label}</strong><small>${target.width} x ${target.height} | ${target.ratio}</small></span>`;
				if (target.id === state.target) button.classList.add("active");
				fragment.append(button);
			}
			elements.gallery.replaceChildren(fragment);
		}

		function render({ refreshTargets = true } = {}) {
			const target = getTarget();
			writeControls();
			state.svg = buildSvg(state.seed, state, target, false);
			elements.preview.style.setProperty("--target-ratio", String(target.width / target.height));
			elements.preview.innerHTML = state.svg;
			if (refreshTargets) renderTargets();
			updateUrl();
		}

		function randomSeed() {
			const now = Date.now().toString(36);
			const entropy = Math.floor(Math.random() * 1679616).toString(36).padStart(4, "0");
			return `foundry-${now}-${entropy}`;
		}

		function stepSeed(delta) {
			const match = state.seed.match(/^(.*?)(?:-(\d+))?$/);
			const prefix = match?.[1] || state.seed;
			const rawNumber = Number(match?.[2] ?? 0);
			const nextNumber = Math.max(0, rawNumber + delta);
			return `${prefix}-${String(nextNumber).padStart(2, "0")}`;
		}

		function loadFromUrl() {
			const params = new URLSearchParams(window.location.search);
			state.seed = params.get("seed") || state.seed;
			state.target = targetMap[params.get("target")] ? params.get("target") : state.target;
			state.density = clamp(Number(params.get("density") || state.density), 1, 10);
			state.layers = clamp(Number(params.get("layers") || state.layers), 2, 8);
			state.accent = clamp(Number(params.get("accent") || state.accent), 1, 10);
			state.palette = palettes[params.get("palette")] ? params.get("palette") : state.palette;
		}

		function downloadSvg() {
			const target = getTarget();
			const blob = new Blob([state.svg], { type: "image/svg+xml" });
			const url = URL.createObjectURL(blob);
			const link = document.createElement("a");
			link.href = url;
			link.download = `covenant-foundry-cathedral-${target.id}-${state.seed}.svg`;
			document.body.append(link);
			link.click();
			link.remove();
			URL.revokeObjectURL(url);
		}

		function bindEvents() {
			[elements.seed, elements.target, elements.density, elements.layers, elements.accent, elements.palette].forEach((input) => {
				input.addEventListener("input", () => {
					readControls();
					render();
				});
			});

			elements.randomize.addEventListener("click", () => {
				state.seed = randomSeed();
				render();
			});

			elements.previous.addEventListener("click", () => {
				state.seed = stepSeed(-1);
				render();
			});

			elements.next.addEventListener("click", () => {
				state.seed = stepSeed(1);
				render();
			});

			elements.gallery.addEventListener("click", (event) => {
				const targetTile = event.target.closest(".target-tile");
				if (!(targetTile instanceof HTMLElement)) return;
				state.target = targetTile.dataset.target || state.target;
				render();
			});

			elements.download.addEventListener("click", downloadSvg);

			elements.copy.addEventListener("click", async () => {
				await navigator.clipboard.writeText(state.seed);
				elements.copy.textContent = "Copied";
				window.setTimeout(() => {
					elements.copy.textContent = "Copy Seed";
				}, 1200);
			});
		}

		populateTargets();
		loadFromUrl();
		bindEvents();
		render();
	</script>
</BaseLayout>
