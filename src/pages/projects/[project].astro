---
import { render } from "astro:content";
import DevlogList from "../../components/DevlogList.astro";
import ProjectFacts from "../../components/ProjectFacts.astro";
import SiteIcon from "../../components/SiteIcon.astro";
import StudioLayout from "../../layouts/StudioLayout.astro";
import {
	devlogHref,
	formatDate,
	getProjectDevlogs,
	getPublishedDevlogs,
	getPublishedProjects,
	projectDomain,
	toDateTime,
	type ProjectEntry,
} from "../../lib/content";

export async function getStaticPaths() {
	const projects = await getPublishedProjects();

	return projects.map((project) => ({
		params: { project: project.id },
		props: { project },
	}));
}

interface Props {
	project: ProjectEntry;
}

const { project } = Astro.props;
const devlogs = getProjectDevlogs(project, await getPublishedDevlogs());
const { Content } = await render(project);
const normalizeHref = (href?: string) => href?.replace(/\/$/, "");
const sourceHref = project.data.repository &&
	normalizeHref(project.data.repository) !== normalizeHref(project.data.support.href)
	? project.data.repository
	: undefined;
const devlogItems = devlogs.map((entry) => ({
	href: devlogHref(entry),
	date: formatDate(entry.data.publishedAt),
	datetime: toDateTime(entry.data.publishedAt),
	title: entry.data.title,
	summary: entry.data.summary,
}));
---

<StudioLayout
	title={`${project.data.name} | Covenant Foundry`}
	description={project.data.description}
>
	<div class="project-page studio-wrap">
		<a class="studio-back-link" href="/projects"><span aria-hidden="true">←</span> All projects</a>

		<article
			class="project-record"
			data-tone={project.data.status.tone}
			aria-labelledby="project-title"
		>
			<header class="project-record__identity">
				<h1 id="project-title">{project.data.name}</h1>
				<div class="project-record__links">
					{
						project.data.website ? (
							<a
								class="project-record__domain"
								href={project.data.website}
								target="_blank"
								rel="noopener noreferrer"
							>
								{projectDomain(project)}
								<SiteIcon name="external-link" />
							</a>
						) : (
							<p class="project-record__domain">{projectDomain(project)}</p>
						)
					}
					{
						sourceHref && (
							<a
								class="project-record__source"
								href={sourceHref}
								target="_blank"
								rel="noopener noreferrer"
							>
								View source <SiteIcon name="external-link" />
							</a>
						)
					}
				</div>
			</header>

			<div class="project-record__description studio-prose">
				<Content />
			</div>

			<ProjectFacts
				status={project.data.status.label}
				statusTone={project.data.status.tone}
				support={project.data.support.label}
				supportHref={project.data.support.href}
			/>

			<DevlogList
				entries={devlogItems}
				headingId="devlog-title"
				sectionId="devlog"
				emptyMessage="The first dev log entry has not been published yet."
			/>
		</article>
	</div>
</StudioLayout>
