---
import FrontPage from "../components/front-page/FrontPage.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
	createProjectDossiers,
	getPublishedDevlogs,
	getPublishedProjects,
} from "../lib/content";

const [projectEntries, devlogEntries] = await Promise.all([
	getPublishedProjects(),
	getPublishedDevlogs(),
]);
const projects = createProjectDossiers(projectEntries, devlogEntries);
---

<BaseLayout
	title="Covenant Foundry"
	description="Covenant Foundry creates useful software and brings Christian builders together around a shared vision of faithfully stewarding our time, talents, and treasures for the kingdom of God."
>
	<FrontPage projects={projects} />
</BaseLayout>
