---
import BrandLogo from "../../components/BrandLogo.astro";
import IconSigil from "../../components/IconSigil.astro";
import VariantLayout from "../../layouts/VariantLayout.astro";
---

<VariantLayout
	title="The Editorial Foundry | Covenant Foundry"
	description="An editorial homepage concept for Covenant Foundry, a Christian software studio and community for builders."
	active="editorial"
>
	<div class="editorial">
		<header class="site-header">
			<a class="wordmark" href="#top" aria-label="Covenant Foundry, back to top">
				<span class="wordmark__mark"><BrandLogo alt="" /></span>
				<span class="wordmark__type">
					<strong>Covenant</strong>
					<span>Foundry</span>
				</span>
			</a>

			<nav class="site-nav" aria-label="Main navigation">
				<a href="#projects">Work</a>
				<a href="#community">Community</a>
				<a href="#about">About</a>
			</nav>

			<a
				class="header-cta"
				href="https://discord.gg/JcWQNBXH42"
				target="_blank"
				rel="noopener"
			>
				Join the builders <span aria-hidden="true">↗</span>
			</a>
		</header>

		<main id="top">
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero__copy">
					<div class="eyebrow">
						<span>Independent software studio</span>
						<span>Built in public</span>
					</div>
					<h1 id="hero-title">Useful software,<br /><em>built with conviction.</em></h1>
					<p class="hero__lede">
						Covenant Foundry is Jon's software studio and a community for Christian builders
						pursuing faithful stewardship through entrepreneurship.
					</p>
					<div class="hero__actions">
						<a class="button button--primary" href="#projects">
							Explore the work <span aria-hidden="true">↓</span>
						</a>
						<a
							class="button button--quiet"
							href="https://discord.gg/JcWQNBXH42"
							target="_blank"
							rel="noopener"
						>
							Join the Discord <span aria-hidden="true">↗</span>
						</a>
					</div>
				</div>

				<div class="hero__art" aria-hidden="true">
					<div class="arch">
						<span class="arch__line arch__line--one"></span>
						<span class="arch__line arch__line--two"></span>
						<span class="arch__axis"></span>
						<span class="arch__cross"></span>
						<div class="arch__mark"><BrandLogo alt="" /></div>
						<p>Make useful things.<br />Share the process.</p>
					</div>
					<span class="hero__folio">CF / Field Note 01</span>
				</div>
			</section>

			<section class="principles" aria-label="Studio principles">
				<p><span>01</span> Build what serves</p>
				<p><span>02</span> Work in the open</p>
				<p><span>03</span> Steward craft well</p>
			</section>

			<section class="work section" id="projects" aria-labelledby="work-title">
				<header class="section-heading">
					<div>
						<p class="section-label">01 / On the workbench</p>
						<h2 id="work-title">Tools and connections<br />for people who build.</h2>
					</div>
					<p class="section-intro">
						Practical projects for Christian founders, shaped in public and improved through
						conversation with the people they serve.
					</p>
				</header>

				<div class="project-grid">
					<article class="project-card project-card--lead">
						<div class="project-card__top">
							<span class="project-card__number">01</span>
							<span class="project-icon"><IconSigil name="ledger" /></span>
						</div>
						<div>
							<p class="project-card__kind">Curated library</p>
							<h3>Founder Resources</h3>
							<p>
								Books, communities, services, and practical guides selected to help Christian
								entrepreneurs build with clarity.
							</p>
						</div>
						<a class="text-link" href="#community">Help shape the library <span aria-hidden="true">→</span></a>
					</article>

					<article class="project-card">
						<div class="project-card__top">
							<span class="project-card__number">02</span>
							<span class="project-icon"><IconSigil name="community" /></span>
						</div>
						<div>
							<p class="project-card__kind">Founder connection</p>
							<h3>Find a Co-founder</h3>
							<p>
								A thoughtful starting point for builders looking for aligned collaborators,
								shared values, and complementary strengths.
							</p>
						</div>
						<a
							class="text-link"
							href="https://discord.gg/JcWQNBXH42"
							target="_blank"
							rel="noopener"
						>
							Meet the community <span aria-hidden="true">↗</span>
						</a>
					</article>

					<article class="project-card project-card--accent">
						<div class="project-card__top">
							<span class="project-card__number">03</span>
							<span class="project-icon"><IconSigil name="code" /></span>
						</div>
						<div>
							<p class="project-card__kind">Open studio practice</p>
							<h3>Build in Public</h3>
							<p>
								Honest notes from the workbench: decisions, experiments, lessons, and the craft
								behind making useful software.
							</p>
						</div>
						<a class="text-link" href="#about">See how we work <span aria-hidden="true">→</span></a>
					</article>
				</div>
			</section>

			<section class="declaration" aria-labelledby="declaration-title">
				<p class="section-label">The foundry standard</p>
				<h2 id="declaration-title">
					Build useful things.<br />Tell the truth about the work.<br /><em>Invite others in.</em>
				</h2>
				<span class="declaration__seal" aria-hidden="true">
					<IconSigil name="cross" />
				</span>
			</section>

			<section class="community section" id="community" aria-labelledby="community-title">
				<div class="community__intro">
					<p class="section-label">02 / The community</p>
					<h2 id="community-title">Build alongside people who share your purpose.</h2>
					<p>
						The Covenant Foundry Discord is a place for Christian founders and builders to
						compare notes, ask useful questions, and encourage one another in the work.
					</p>
					<a
						class="button button--primary"
						href="https://discord.gg/JcWQNBXH42"
						target="_blank"
						rel="noopener"
					>
						Join the Discord <span aria-hidden="true">↗</span>
					</a>
				</div>

				<div class="community__list">
					<p class="community__list-title">Inside the community</p>
					<ul>
						<li>
							<span>01</span>
							<div><strong>Practical conversation</strong><p>Ask specific questions and learn from active builders.</p></div>
						</li>
						<li>
							<span>02</span>
							<div><strong>Honest build notes</strong><p>Share progress, decisions, obstacles, and lessons.</p></div>
						</li>
						<li>
							<span>03</span>
							<div><strong>Founder connection</strong><p>Meet collaborators grounded in faith and useful work.</p></div>
						</li>
					</ul>
				</div>
			</section>

			<section class="about section" id="about" aria-labelledby="about-title">
				<div class="about__monogram" aria-hidden="true">
					<span>J</span>
					<small>Founder / Builder</small>
				</div>
				<div class="about__copy">
					<p class="section-label">03 / Behind the studio</p>
					<h2 id="about-title">Hi, I'm Jon.</h2>
					<p class="about__lead">
						Covenant Foundry is my software studio. I use my time, talents, and treasures to
						bring glory to God, and my favorite way to do that is to build useful tools.
					</p>
					<p>
						I share the process because good work gets better through honest conversation—and
						because building is easier when we do it alongside one another.
					</p>
					<a class="text-link" href="#community">Come build with us <span aria-hidden="true">↑</span></a>
				</div>
			</section>
		</main>

		<footer class="footer">
			<div class="footer__brand">
				<span class="footer__mark"><BrandLogo alt="" /></span>
				<div>
					<strong>Covenant Foundry</strong>
					<p>Software studio &amp; builder community</p>
				</div>
			</div>
			<nav aria-label="Footer navigation">
				<a href="#projects">Work</a>
				<a href="#community">Community</a>
				<a href="#about">About</a>
				<a href="https://github.com/Covenant-Foundry" target="_blank" rel="noopener">GitHub ↗</a>
				<a href="https://discord.gg/JcWQNBXH42" target="_blank" rel="noopener">Discord ↗</a>
			</nav>
			<p class="footer__note">Build faithfully. Share generously.</p>
		</footer>
	</div>
</VariantLayout>

<style>
	.editorial {
		--ink: #0a0b0a;
		--surface: #10110f;
		--surface-raised: #151612;
		--paper: #eee7d7;
		--paper-dim: #c9bfab;
		--muted: #968d7b;
		--brass: #b58a45;
		--brass-soft: rgba(181, 138, 69, 0.35);
		--signal: #f47f16;
		--teal: #73bbb8;
		--serif: "Iowan Old Style", "Palatino Linotype", Palatino, Baskerville, Georgia, serif;
		--sans: "Avenir Next", Avenir, Inter, "Segoe UI", sans-serif;
		--mono: "IBM Plex Mono", "SFMono-Regular", Consolas, monospace;
		position: relative;
		overflow: clip;
		min-height: 100vh;
		background:
			radial-gradient(circle at 77% 10%, rgba(244, 127, 22, 0.1), transparent 25rem),
			linear-gradient(90deg, transparent calc(50% - 1px), rgba(181, 138, 69, 0.05) 50%, transparent calc(50% + 1px)),
			var(--ink);
		color: var(--paper);
		font-family: var(--sans);
		line-height: 1.55;
	}

	.editorial::before {
		position: absolute;
		top: 0;
		bottom: 0;
		left: clamp(1rem, 3vw, 3rem);
		width: 1px;
		content: "";
		background: linear-gradient(var(--brass), transparent 36rem);
		opacity: 0.42;
	}

	.editorial a:focus-visible {
		outline: 2px solid var(--signal);
		outline-offset: 4px;
	}

	.site-header,
	.editorial main,
	.footer {
		width: min(100% - clamp(2rem, 7vw, 8rem), 1460px);
		margin-inline: auto;
	}

	.site-header {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		min-height: 96px;
		border-bottom: 1px solid var(--brass-soft);
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.8rem;
		width: max-content;
		min-height: 48px;
	}

	.wordmark__mark {
		width: 2.65rem;
		filter: drop-shadow(0 0 14px rgba(244, 127, 22, 0.18));
	}

	.wordmark__mark :global(img),
	.arch__mark :global(img),
	.footer__mark :global(img) {
		width: 100%;
		height: auto;
	}

	.wordmark__type {
		display: flex;
		flex-direction: column;
		font-family: var(--serif);
		font-size: 1rem;
		line-height: 0.88;
		letter-spacing: 0.015em;
	}

	.wordmark__type strong {
		font-weight: 700;
	}

	.wordmark__type span {
		color: var(--brass);
		font-size: 0.88em;
		font-style: italic;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: clamp(0.2rem, 2vw, 1.8rem);
	}

	.site-nav a,
	.footer nav a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding-inline: 0.7rem;
		color: var(--paper-dim);
		font: 700 0.7rem/1 var(--mono);
		letter-spacing: 0.11em;
		text-transform: uppercase;
		transition: color 160ms ease;
	}

	.site-nav a:hover,
	.footer nav a:hover {
		color: var(--signal);
	}

	.header-cta {
		justify-self: end;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.8rem;
		min-height: 46px;
		padding-inline: 1.1rem;
		border: 1px solid var(--brass);
		color: var(--paper);
		font: 700 0.68rem/1 var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: border-color 160ms ease, background 160ms ease, color 160ms ease;
	}

	.header-cta:hover {
		border-color: var(--signal);
		background: var(--signal);
		color: var(--ink);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(22rem, 0.75fr);
		min-height: min(820px, calc(100svh - 142px));
		border-bottom: 1px solid var(--brass-soft);
	}

	.hero__copy {
		align-self: center;
		padding: clamp(5rem, 10vw, 9.5rem) clamp(2rem, 6vw, 7rem) clamp(5rem, 9vw, 8rem) 0;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: clamp(1.5rem, 3vw, 2.4rem);
		color: var(--brass);
		font: 700 0.69rem/1.2 var(--mono);
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.eyebrow::before {
		width: 2.4rem;
		height: 1px;
		content: "";
		background: var(--signal);
	}

	.eyebrow span + span {
		color: var(--muted);
	}

	.eyebrow span + span::before {
		margin-right: 1rem;
		content: "/";
		color: var(--brass);
	}

	.hero h1 {
		max-width: 9ch;
		color: var(--paper);
		font-family: var(--serif);
		font-size: clamp(4.5rem, 8vw, 9rem);
		font-weight: 500;
		line-height: 0.83;
		letter-spacing: -0.055em;
	}

	.hero h1 em,
	.declaration h2 em {
		color: var(--brass);
		font-weight: 400;
	}

	.hero__lede {
		max-width: 58ch;
		margin-top: clamp(2rem, 4vw, 3rem);
		color: var(--paper-dim);
		font-size: clamp(1.05rem, 1.35vw, 1.25rem);
		line-height: 1.7;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2.2rem;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		min-height: 52px;
		padding: 0.85rem 1.1rem;
		font: 750 0.75rem/1 var(--mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		transition: background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.button--primary {
		border: 1px solid var(--signal);
		background: var(--signal);
		color: var(--ink);
	}

	.button--primary:hover {
		background: #ff9a3f;
		border-color: #ff9a3f;
	}

	.button--quiet {
		border: 1px solid var(--brass-soft);
		color: var(--paper);
	}

	.button--quiet:hover {
		border-color: var(--brass);
		background: rgba(181, 138, 69, 0.08);
	}

	.hero__art {
		position: relative;
		display: grid;
		place-items: center;
		min-width: 0;
		border-left: 1px solid var(--brass-soft);
		background:
			linear-gradient(rgba(181, 138, 69, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(181, 138, 69, 0.055) 1px, transparent 1px),
			radial-gradient(circle at 50% 40%, rgba(244, 127, 22, 0.1), transparent 43%),
			#0c0d0b;
		background-size: 34px 34px, 34px 34px, auto, auto;
	}

	.hero__art::before,
	.hero__art::after {
		position: absolute;
		width: 4.5rem;
		height: 4.5rem;
		content: "";
	}

	.hero__art::before {
		top: 1rem;
		left: 1rem;
		border-top: 1px solid var(--brass);
		border-left: 1px solid var(--brass);
	}

	.hero__art::after {
		right: 1rem;
		bottom: 1rem;
		border-right: 1px solid var(--brass);
		border-bottom: 1px solid var(--brass);
	}

	.arch {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		width: min(72%, 25rem);
		aspect-ratio: 0.69;
		border: 1px solid var(--brass);
		border-radius: 50% 50% 0 0 / 31% 31% 0 0;
		background: linear-gradient(180deg, rgba(181, 138, 69, 0.08), rgba(8, 9, 8, 0.78) 55%);
		box-shadow: 0 0 70px rgba(0, 0, 0, 0.55), inset 0 0 60px rgba(244, 127, 22, 0.035);
	}

	.arch::before,
	.arch::after,
	.arch__line {
		position: absolute;
		content: "";
		border: 1px solid var(--brass-soft);
		border-radius: inherit;
	}

	.arch::before {
		inset: 4.5%;
	}

	.arch::after {
		inset: 10%;
		border-color: rgba(181, 138, 69, 0.18);
	}

	.arch__line--one {
		inset: -6%;
	}

	.arch__line--two {
		inset: -11%;
		border-color: rgba(181, 138, 69, 0.12);
	}

	.arch__axis {
		position: absolute;
		top: 15%;
		bottom: 12%;
		left: 50%;
		width: 1px;
		background: linear-gradient(transparent, var(--brass-soft), transparent);
	}

	.arch__cross {
		position: absolute;
		top: 17%;
		left: 50%;
		width: 1.4rem;
		height: 2rem;
		border: 1px solid var(--signal);
		clip-path: polygon(36% 0, 64% 0, 64% 34%, 100% 34%, 100% 57%, 64% 57%, 64% 100%, 36% 100%, 36% 57%, 0 57%, 0 34%, 36% 34%);
		background: rgba(244, 127, 22, 0.13);
		box-shadow: 0 0 20px rgba(244, 127, 22, 0.3);
		transform: translateX(-50%);
	}

	.arch__mark {
		position: relative;
		z-index: 1;
		width: 42%;
		margin-top: 1.5rem;
		filter: drop-shadow(0 0 28px rgba(244, 127, 22, 0.16));
	}

	.arch p {
		position: absolute;
		right: 0;
		bottom: 8%;
		left: 0;
		z-index: 2;
		color: var(--brass);
		font: 650 0.66rem/1.65 var(--mono);
		letter-spacing: 0.13em;
		text-align: center;
		text-transform: uppercase;
	}

	.hero__folio {
		position: absolute;
		right: 1.25rem;
		bottom: 1.3rem;
		color: var(--muted);
		font: 600 0.58rem/1 var(--mono);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		writing-mode: vertical-rl;
	}

	.principles {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-bottom: 1px solid var(--brass-soft);
	}

	.principles p {
		display: flex;
		align-items: center;
		min-height: 88px;
		padding: 1rem clamp(1rem, 3vw, 2.5rem);
		color: var(--paper-dim);
		font-family: var(--serif);
		font-size: clamp(1rem, 1.3vw, 1.2rem);
	}

	.principles p + p {
		border-left: 1px solid var(--brass-soft);
	}

	.principles span {
		margin-right: 1rem;
		color: var(--signal);
		font: 700 0.62rem/1 var(--mono);
	}

	.section {
		padding-block: clamp(6rem, 11vw, 11rem);
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
		align-items: end;
		gap: clamp(3rem, 8vw, 9rem);
		margin-bottom: clamp(3rem, 6vw, 5.5rem);
	}

	.section-label,
	.project-card__kind,
	.community__list-title {
		color: var(--signal);
		font: 750 0.68rem/1.35 var(--mono);
		letter-spacing: 0.13em;
		text-transform: uppercase;
	}

	.section-heading h2,
	.community h2,
	.about h2 {
		margin-top: 1.35rem;
		color: var(--paper);
		font-family: var(--serif);
		font-size: clamp(3.1rem, 6vw, 6.8rem);
		font-weight: 500;
		line-height: 0.9;
		letter-spacing: -0.045em;
	}

	.section-intro {
		max-width: 44ch;
		color: var(--paper-dim);
		font-size: 1rem;
		line-height: 1.75;
	}

	.project-grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr 0.85fr;
		border-top: 1px solid var(--brass);
		border-bottom: 1px solid var(--brass-soft);
	}

	.project-card {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: 4rem;
		min-height: 35rem;
		padding: clamp(1.5rem, 3vw, 2.8rem);
		background: rgba(16, 17, 15, 0.72);
		transition: background 180ms ease;
	}

	.project-card + .project-card {
		border-left: 1px solid var(--brass-soft);
	}

	.project-card:hover {
		background: rgba(21, 22, 18, 0.96);
	}

	.project-card--lead {
		background:
			linear-gradient(135deg, rgba(181, 138, 69, 0.11), transparent 45%),
			rgba(16, 17, 15, 0.82);
	}

	.project-card--accent::after {
		position: absolute;
		top: -1px;
		right: 0;
		width: 4.2rem;
		height: 4.2rem;
		border-top: 1px solid var(--signal);
		border-right: 1px solid var(--signal);
		content: "";
	}

	.project-card__top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}

	.project-card__number {
		color: var(--muted);
		font: 700 0.66rem/1 var(--mono);
		letter-spacing: 0.1em;
	}

	.project-icon {
		width: 3.4rem;
		color: var(--brass);
	}

	.project-icon :global(.icon-sigil),
	.declaration__seal :global(.icon-sigil) {
		width: 100%;
		fill: none;
		stroke: currentColor;
