---
import BrandLogo from "../../components/BrandLogo.astro";
import IconSigil from "../../components/IconSigil.astro";
import SiteIcon from "../../components/SiteIcon.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import VariantLayout from "../../layouts/VariantLayout.astro";

const discordUrl = "https://discord.gg/JcWQNBXH42";

const projects = [
	{
		title: "Covenant Foundry",
		category: "Studio platform",
		description:
			"A clearer home base for the studio, its work, and the community growing around it.",
		status: "In the forge",
		tone: "building" as const,
		stage: "Homepage redesign",
		icon: "code" as const,
		signal: "Current focus: information architecture, visual system, and mobile polish",
	},
	{
		title: "Founder connections",
		category: "Community pathway",
		description:
			"A practical way for Christian founders to meet aligned collaborators and potential cofounders.",
		status: "Open",
		tone: "live" as const,
		stage: "Community-led",
		icon: "community" as const,
		signal: "Active venue: the Covenant Foundry Discord",
	},
	{
		title: "Builder resources",
		category: "Knowledge base",
		description:
			"Useful books, communities, and field notes gathered for faith-driven entrepreneurs.",
		status: "Curating",
		tone: "building" as const,
		stage: "Content system",
		icon: "ledger" as const,
		signal: "Next focus: make the library easier to browse and maintain",
	},
];

const buildLog = [
	{
		marker: "Now",
		title: "Reworking the homepage around a clear first visit",
		body: "Lead with the studio mission, surface real work quickly, then make the community invitation easy to act on.",
		tag: "Designing",
	},
	{
		marker: "Decision",
		title: "Giving each visual influence a specific job",
		body: "Deco sets the structure, brass defines the hardware, cyber signals state, and the cathedral motif carries the identity.",
		tag: "Recorded",
	},
	{
		marker: "Next",
		title: "Validate the complete path on small screens",
		body: "Check reading rhythm, tap targets, focus states, and whether every section still feels deliberate at 390 pixels.",
		tag: "Queued",
	},
];
---

<VariantLayout
	title="The Foundry Console | Covenant Foundry"
	description="A build-in-public homepage concept for Covenant Foundry, a Christian software studio and founder community."
	active="console"
>
	<div class="console">
		<header class="console-header">
			<a class="brand" href="#top" aria-label="Covenant Foundry home">
				<span class="brand__mark"><BrandLogo alt="" /></span>
				<span class="brand__type">
					<strong>Covenant Foundry</strong>
					<small>Build signal / online</small>
				</span>
			</a>
			<nav class="console-nav" aria-label="Homepage sections">
				<a href="#projects">Projects</a>
				<a href="#build-log">Build log</a>
				<a href="#community">Community</a>
				<a href="#about">About</a>
			</nav>
			<a class="header-cta" href={discordUrl} target="_blank" rel="noopener">
				Join Discord <SiteIcon name="external-link" />
			</a>
		</header>

		<main id="top">
			<section class="hero" aria-labelledby="console-title">
				<div class="hero__copy">
					<div class="eyebrow">
						<span class="signal-dot" aria-hidden="true"></span>
						Public software studio / Ohio, USA
					</div>
					<h1 id="console-title">Building useful tools <em>with purpose.</em></h1>
					<p class="hero__lede">
						Covenant Foundry is Jon Winsley’s software studio and a gathering place for Christian
						builders pursuing faithful stewardship through entrepreneurship.
					</p>
					<div class="hero__actions">
						<a class="button button--primary" href="#projects">
							Explore the work <span aria-hidden="true">↓</span>
						</a>
						<a class="button button--secondary" href={discordUrl} target="_blank" rel="noopener">
							Meet the builders <SiteIcon name="external-link" />
						</a>
					</div>
					<ul class="hero__principles" aria-label="Studio principles">
						<li>Faithful stewardship</li>
						<li>Useful software</li>
						<li>Open process</li>
					</ul>
				</div>

				<aside class="command-panel" aria-label="Foundry operating console">
					<div class="panel-chrome">
						<span>CF / OPERATIONS</span>
						<StatusBadge status="Forge active" tone="live" />
					</div>
					<div class="command-mark" aria-hidden="true">
						<span class="command-mark__ring"></span>
						<BrandLogo alt="" />
					</div>
					<dl class="readout">
						<div>
							<dt>Operating principle</dt>
							<dd>Time, talents &amp; treasures</dd>
						</div>
						<div>
							<dt>Now building</dt>
							<dd>Studio homepage redesign</dd>
						</div>
						<div>
							<dt>Working mode</dt>
							<dd>Build in public</dd>
						</div>
						<div>
							<dt>Community channel</dt>
							<dd>Open in Discord</dd>
						</div>
					</dl>
					<div class="console-trace" aria-hidden="true">
						<span></span><span></span><span></span><span></span><span></span>
					</div>
				</aside>
			</section>

			<div class="process-rail" aria-label="How work moves through the foundry">
				<span class="process-rail__label">Foundry loop</span>
				<ol>
					<li><b>01</b> Discern</li>
					<li><b>02</b> Shape</li>
					<li><b>03</b> Ship</li>
					<li><b>04</b> Share</li>
				</ol>
			</div>

			<section id="projects" class="section projects" aria-labelledby="projects-title">
				<header class="section-heading">
					<div>
						<p class="section-code">01 / Active work</p>
						<h2 id="projects-title">On the bench</h2>
					</div>
					<p>
						Work is shared by state and intent, so you can see what is moving, what comes next, and
						where collaboration helps.
					</p>
				</header>

				<div class="project-board">
					<div class="project-list">
						{
							projects.map((project, index) => (
								<article class:list={["project-card", index === 0 && "project-card--featured"]}>
									<div class="project-card__index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</div>
									<div class="project-card__icon"><IconSigil name={project.icon} /></div>
									<div class="project-card__body">
										<p class="project-card__category">{project.category}</p>
										<h3>{project.title}</h3>
										<p>{project.description}</p>
										<div class="project-card__signal">
											<span aria-hidden="true"></span>{project.signal}
										</div>
									</div>
									<div class="project-card__state">
										<StatusBadge status={project.status} tone={project.tone} />
										<small>{project.stage}</small>
									</div>
								</article>
							))
						}
					</div>

					<aside class="queue-panel" aria-labelledby="queue-title">
						<div class="panel-label"><span>Priority stack</span><span>Live view</span></div>
						<h3 id="queue-title">Project queue</h3>
						<ol>
							<li>
								<span>Focus</span>
								<strong>Make the new homepage useful before adding more surface area.</strong>
							</li>
							<li>
								<span>Next</span>
								<strong>Reconnect the resource library to a clearer content system.</strong>
							</li>
							<li>
								<span>Always on</span>
								<strong>Help founders find peers, feedback, and aligned collaborators.</strong>
							</li>
						</ol>
						<a href="#build-log" class="text-link">Read the build signal <span aria-hidden="true">→</span></a>
					</aside>
				</div>
			</section>

			<section id="build-log" class="section build-log" aria-labelledby="log-title">
				<header class="section-heading section-heading--compact">
					<div>
						<p class="section-code">02 / Workshop feed</p>
						<h2 id="log-title">Build log</h2>
					</div>
					<p>Current decisions and the next useful move—kept close to the work.</p>
				</header>

				<div class="log-grid">
					<div class="log-list">
						{
							buildLog.map((entry) => (
								<article class="log-entry">
									<div class="log-entry__marker">
										<span aria-hidden="true"></span>
										<strong>{entry.marker}</strong>
									</div>
									<div>
										<h3>{entry.title}</h3>
										<p>{entry.body}</p>
									</div>
									<small>{entry.tag}</small>
								</article>
							))
						}
					</div>
					<aside class="transparency-note">
						<IconSigil name="gear" />
						<p class="section-code">Build-in-public protocol</p>
						<h3>Show the work while it is still useful to discuss.</h3>
						<p>
							Plans, tradeoffs, and lessons belong in the open. The goal is better work and more chances
							to help one another build wisely.
						</p>
						<a class="text-link" href={discordUrl} target="_blank" rel="noopener">
							Join the conversation <SiteIcon name="external-link" />
						</a>
					</aside>
				</div>
			</section>

			<section id="community" class="community" aria-labelledby="community-title">
				<div class="community__signal" aria-hidden="true">
					<IconSigil name="community" />
					<span></span><span></span><span></span>
				</div>
				<div class="community__copy">
					<p class="section-code">03 / Open channel</p>
					<h2 id="community-title">Build with people who share your purpose.</h2>
					<p>
						The Covenant Foundry community is for Christian builders and founders looking for honest
						feedback, practical help, and meaningful collaboration.
					</p>
					<a class="button button--primary" href={discordUrl} target="_blank" rel="noopener">
						Join the Discord <SiteIcon name="external-link" />
					</a>
				</div>
				<ul class="community__routes" aria-label="Ways to participate">
					<li><span>Introduce</span><strong>Meet other faith-driven builders</strong></li>
					<li><span>Collaborate</span><strong>Find peers and potential cofounders</strong></li>
					<li><span>Share</span><strong>Bring work in progress and useful lessons</strong></li>
				</ul>
			</section>

			<section id="about" class="section about" aria-labelledby="about-title">
				<div class="about__label">
					<IconSigil name="cross" />
					<span>Founder note / Jon Winsley</span>
				</div>
				<div class="about__copy">
					<p class="section-code">04 / About the studio</p>
					<h2 id="about-title">Hi, I’m Jon.</h2>
					<p class="about__lead">
						I’m a Christian, husband, father, deacon, software developer, and entrepreneur building
						from small-town Ohio.
					</p>
					<p>
						Covenant Foundry is where I use my time, talents, and treasures to build useful tools,
						share what I learn, and create stronger connections among Christian founders.
					</p>
					<div class="about__links">
						<a class="text-link" href="#projects">See what I’m building <span aria-hidden="true">↑</span></a>
						<a class="text-link" href={discordUrl} target="_blank" rel="noopener">Say hello in Discord <SiteIcon name="external-link" /></a>
					</div>
				</div>
			</section>
		</main>

		<footer class="console-footer">
			<a class="brand brand--footer" href="#top" aria-label="Back to the top">
				<span class="brand__mark"><BrandLogo alt="" /></span>
				<span class="brand__type"><strong>Covenant Foundry</strong><small>Built with purpose</small></span>
			</a>
			<nav aria-label="Footer navigation">
				<a href="#projects">Projects</a>
				<a href="#build-log">Build log</a>
				<a href="#community">Community</a>
				<a href="#about">About</a>
			</nav>
			<div class="console-footer__meta">
				<a class="console-footer__icon-link" href={discordUrl} target="_blank" rel="noopener" aria-label="Discord" title="Discord"><SiteIcon name="discord" /></a>
				<a class="console-footer__icon-link" href="https://github.com/Covenant-Foundry" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub"><SiteIcon name="github" /></a>
				<span>© 2026 Covenant Foundry</span>
			</div>
		</footer>
	</div>
</VariantLayout>

<style>
	.console {
		--console-orange: #ff8628;
		--console-teal: #7bc9c4;
		--console-brass: #b58a45;
		--console-ivory: #f4eddd;
		--console-paper: #d6cdbb;
		--console-muted: #938b7b;
		--console-ink: #080908;
		--console-panel: #101310;
		--console-line: rgba(181, 138, 69, 0.32);
		position: relative;
		overflow: clip;
		min-height: 100vh;
		background:
			radial-gradient(circle at 72% 9%, rgba(244, 127, 22, 0.1), transparent 23rem),
			linear-gradient(rgba(181, 138, 69, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(181, 138, 69, 0.045) 1px, transparent 1px),
			#090b09;
		background-size: auto, 42px 42px, 42px 42px, auto;
		color: var(--console-ivory);
		font-family: "Avenir Next", Avenir, "Segoe UI", ui-sans-serif, system-ui, sans-serif;
	}

	.console :global(.site-icon--external-link) {
		width: 0.9rem;
		height: 0.9rem;
	}

	.console::before {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		content: "";
		background: linear-gradient(90deg, rgba(0, 0, 0, 0.48), transparent 14%, transparent 86%, rgba(0, 0, 0, 0.48));
	}

	.console > * {
		position: relative;
		z-index: 1;
	}

	.console a:focus-visible {
		outline: 2px solid var(--console-teal);
		outline-offset: 4px;
	}

	.console-header,
	.console main,
	.console-footer {
		width: min(1440px, calc(100% - clamp(1.25rem, 4vw, 4rem)));
		margin-inline: auto;
	}

	.console-header {
		display: grid;
		grid-template-columns: minmax(15rem, 1fr) auto minmax(15rem, 1fr);
		gap: 1.5rem;
		align-items: center;
		min-height: 88px;
		border-bottom: 1px solid var(--console-line);
	}

	.brand {
		display: inline-flex;
		width: fit-content;
		min-height: 44px;
		align-items: center;
		gap: 0.75rem;
	}

	.brand__mark {
		display: grid;
		width: 2.8rem;
		height: 2.8rem;
		place-items: center;
	}

	.brand__mark :global(img) {
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.brand__type {
		display: grid;
		gap: 0.08rem;
	}

	.brand__type strong,
	.brand__type small,
	.console-nav,
	.header-cta,
	.eyebrow,
	.section-code,
	.panel-chrome,
	.readout,
	.process-rail,
	.project-card__index,
	.project-card__category,
	.project-card__signal,
	.project-card__state,
	.panel-label,
	.queue-panel li span,
	.text-link,
	.log-entry__marker,
	.log-entry > small,
	.community__routes span,
	.about__label,
	.console-footer {
		font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
	}

	.brand__type strong {
		font-size: 0.88rem;
		letter-spacing: 0.08em;
		line-height: 1.1;
		text-transform: uppercase;
	}

	.brand__type small {
		color: var(--console-teal);
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.console-nav {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.2rem;
		color: var(--console-paper);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.console-nav a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		padding-inline: 0.85rem;
		border-bottom: 1px solid transparent;
	}

	.console-nav a:hover {
		border-color: var(--console-orange);
		color: var(--console-orange);
	}

	.header-cta {
		display: inline-flex;
		justify-self: end;
		min-height: 44px;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 0.6rem 1rem;
		border: 1px solid rgba(181, 138, 69, 0.64);
		color: var(--console-ivory);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.header-cta:hover {
		border-color: var(--console-orange);
		color: var(--console-orange);
	}

	.console main {
		display: grid;
		gap: clamp(5rem, 10vw, 9rem);
		padding-bottom: clamp(5rem, 10vw, 9rem);
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(25rem, 0.92fr);
		gap: clamp(2.5rem, 6vw, 7rem);
		min-height: min(760px, calc(100vh - 134px));
		align-items: center;
		padding: clamp(5rem, 10vw, 9rem) clamp(0rem, 3vw, 2.5rem) 4rem;
	}

	.hero__copy {
		max-width: 49rem;
	}

	.eyebrow,
	.section-code {
		color: var(--console-orange);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin-bottom: 1.4rem;
	}

	.signal-dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--console-teal);
		box-shadow: 0 0 18px rgba(123, 201, 196, 0.7);
		animation: signal-pulse 2.8s ease-in-out infinite;
	}

	.hero h1,
	.section-heading h2,
	.community h2,
	.about h2 {
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-weight: 500;
		letter-spacing: -0.045em;
	}

	.hero h1 {
		max-width: 12ch;
		font-size: clamp(4.1rem, 7.5vw, 8.4rem);
		line-height: 0.86;
	}

	.hero h1 em {
		display: block;
		color: var(--console-brass);
		font-weight: 400;
	}

	.hero__lede {
		max-width: 62ch;
		margin-top: 1.8rem;
		color: var(--console-paper);
		font-size: clamp(1rem, 1.3vw, 1.16rem);
		line-height: 1.75;
	}

	.hero__actions,
	.about__links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.button {
		display: inline-flex;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		padding: 0.75rem 1.15rem;
		border: 1px solid var(--console-orange);
		font: 800 0.75rem/1 ui-monospace, "SFMono-Regular", Consolas, monospace;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
	}

	.button--primary {
		background: var(--console-orange);
		color: #120b05;
	}

	.button--primary:hover {
		background: var(--console-ivory);
		border-color: var(--console-ivory);
	}

	.button--secondary {
		border-color: rgba(181, 138, 69, 0.72);
		color: var(--console-paper);
	}

	.button--secondary:hover {
		border-color: var(--console-teal);
		color: var(--console-teal);
	}

	.hero__principles {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.35rem;
		margin: 2rem 0 0;
		padding: 0;
		color: var(--console-muted);
		font: 700 0.68rem/1.4 ui-monospace, "SFMono-Regular", Consolas, monospace;
		letter-spacing: 0.06em;
		list-style: none;
		text-transform: uppercase;
	}

	.hero__principles li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.hero__principles li::before {
		width: 0.28rem;
		height: 0.28rem;
		content: "";
		background: var(--console-brass);
		transform: rotate(45deg);
	}

	.command-panel,
	.queue-panel,
	.transparency-note {
		position: relative;
		border: 1px solid rgba(181, 138, 69, 0.58);
		background:
			linear-gradient(135deg, rgba(181, 138, 69, 0.08), transparent 34%),
			rgba(11, 14, 12, 0.94);
		box-shadow: 0 34px 90px rgba(0, 0, 0, 0.35);
	}

	.command-panel::before,
	.queue-panel::before,
	.transparency-note::before {
		position: absolute;
		inset: 8px;
		pointer-events: none;
		border: 1px solid rgba(181, 138, 69, 0.18);
		content: "";
		clip-path: polygon(0 18px, 18px 18px, 18px 0, calc(100% - 18px) 0, calc(100% - 18px) 18px, 100% 18px, 100% calc(100% - 18px), calc(100% - 18px) calc(100% - 18px), calc(100% - 18px) 100%, 18px 100%, 18px calc(100% - 18px), 0 calc(100% - 18px));
	}

	.command-panel {
		min-height: 34rem;
		padding: 1rem;
	}

	.panel-chrome,
	.panel-label {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		color: var(--console-muted);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.panel-chrome {
		position: relative;
		z-index: 2;
		min-height: 36px;
		padding: 0 0.25rem 0.75rem;
		border-bottom: 1px solid var(--console-line);
	}

	.command-panel :global(.status-badge) {
		font-size: 0.61rem;
	}

	.command-mark {
		position: relative;
		display: grid;
		width: 8.5rem;
		height: 8.5rem;
		place-items: center;
		margin: 2rem auto;
	}

	.command-mark::before,
	.command-mark::after,
	.command-mark__ring {
		position: absolute;
		border: 1px solid rgba(181, 138, 69, 0.5);
		border-radius: 50%;
		content: "";
	}

	.command-mark::before {
		inset: 0;
		border-style: dashed;
		animation: slow-spin 28s linear infinite;
	}

	.command-mark::after {
		inset: 0.65rem;
		border-color: rgba(123, 201, 196, 0.34);
	}

	.command-mark__ring {
		inset: 1.2rem;
		border-color: rgba(244, 127, 22, 0.44);
		box-shadow: 0 0 38px rgba(244, 127, 22, 0.12);
	}

	.command-mark :global(img) {
		position: relative;
		z-index: 2;
		width: 5.3rem;
		height: 5.3rem;
		object-fit: contain;
	}

	.readout {
		position: relative;
		z-index: 2;
		display: grid;
		margin: 0;
		border-top: 1px solid var(--console-line);
	}

	.readout > div {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: 1rem;
		padding: 0.65rem 0.25rem;
		border-bottom: 1px solid rgba(181, 138, 69, 0.2);
	}

	.readout dt,
	.readout dd {
		margin: 0;
		font-size: 0.67rem;
		line-height: 1.45;
	}

	.readout dt {
		color: var(--console-muted);
		text-transform: uppercase;
	}

	.readout dd {
		color: var(--console-ivory);
		text-align: right;
	}

	.console-trace {
		display: grid;
		grid-template-columns: 0.6fr 1fr 0.35fr 1.4fr 0.75fr;
		gap: 0.3rem;
		align-items: end;
		height: 2.6rem;
		padding: 0.65rem 0.25rem 0;
	}

	.console-trace span {
		display: block;
		height: 1px;
		background: var(--console-teal);
		box-shadow: 0 0 8px rgba(123, 201, 196, 0.55);
		transform-origin: left;
		animation: trace-live 3.8s ease-in-out infinite;
	}

	.console-trace span:nth-child(2) { animation-delay: -1.6s; }
	.console-trace span:nth-child(3) { animation-delay: -2.4s; }
	.console-trace span:nth-child(4) { animation-delay: -0.8s; }
	.console-trace span:nth-child(5) { animation-delay: -3s; }

	.process-rail {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		gap: 2rem;
		align-items: center;
		margin-top: calc(clamp(5rem, 10vw, 9rem) * -1 + 1rem);
		padding: 0.8rem 0;
		border-top: 1px solid var(--console-line);
		border-bottom: 1px solid var(--console-line);
		color: var(--console-muted);
		font-size: 0.65rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.process-rail__label {
		color: var(--console-orange);
	}

	.process-rail ol {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.process-rail li {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding-left: 1rem;
		border-left: 1px solid var(--console-line);
	}

	.process-rail b {
		color: var(--console-brass);
	}

	.section {
		scroll-margin-top: 7rem;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(20rem, 0.65fr);
		gap: 2rem;
		align-items: end;
		margin-bottom: 2.4rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--console-line);
	}

	.section-heading h2,
	.community h2,
	.about h2 {
		font-size: clamp(3rem, 6vw, 6.2rem);
		line-height: 0.92;
	}

	.section-heading h2 {
		margin-top: 0.65rem;
	}

	.section-heading > p {
		max-width: 58ch;
		justify-self: end;
		color: var(--console-paper);
		font-size: 0.98rem;
		line-height: 1.7;
	}

	.section-heading--compact {
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.48fr);
	}

	.project-board {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(19rem, 0.62fr);
		gap: 1rem;
		align-items: stretch;
	}

	.project-list {
		display: grid;
		border-top: 1px solid var(--console-line);
	}

	.project-card {
		display: grid;
		grid-template-columns: 2.4rem 4.5rem minmax(0, 1fr) minmax(9rem, auto);
		gap: 1rem;
		align-items: start;
		padding: 1.45rem 0;
		border-bottom: 1px solid var(--console-line);
	}

	.project-card--featured {
		background: linear-gradient(90deg, rgba(244, 127, 22, 0.07), transparent 76%);
	}

	.project-card__index {
		padding-top: 0.25rem;
		color: var(--console-brass);
		font-size: 0.68rem;
	}

	.project-card__icon {
		padding-top: 0.1rem;
	}

	.project-card__icon :global(.icon-sigil) {
		width: 3.6rem;
		height: 3.6rem;
		color: var(--console-brass);
	}

	.project-card--featured .project-card__icon :global(.icon-sigil) {
		color: var(--console-orange);
	}

	.project-card__category {
		margin-bottom: 0.25rem;
		color: var(--console-muted);
		font-size: 0.64rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.project-card h3 {
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.6rem, 2.4vw, 2.2rem);
		font-weight: 500;
		letter-spacing: -0.025em;
	}

	.project-card__body > p:not(.project-card__category) {
		max-width: 58ch;
		margin-top: 0.45rem;
		color: var(--console-paper);
		font-size: 0.94rem;
		line-height: 1.6;
	}

	.project-card__signal {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin-top: 0.85rem;
		color: var(--console-muted);
		font-size: 0.65rem;
		line-height: 1.5;
	}

	.project-card__signal span {
		flex: 0 0 auto;
		width: 0.4rem;
		height: 0.4rem;
		margin-top: 0.27rem;
		background: var(--console-teal);
	}

	.project-card__state {
		display: grid;
		justify-items: end;
		gap: 0.55rem;
		padding-top: 0.2rem;
	}

	.project-card__state small {
		color: var(--console-muted);
		font-size: 0.62rem;
		text-align: right;
		text-transform: uppercase;
	}

	.project-card__state :global(.status-badge) {
		white-space: nowrap;
	}

	.queue-panel {
		padding: 1.45rem;
	}

	.queue-panel > * {
		position: relative;
		z-index: 2;
	}

	.panel-label {
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--console-line);
	}

	.panel-label span:last-child {
		color: var(--console-teal);
	}

	.queue-panel h3 {
		margin: 1.4rem 0 0.4rem;
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: 2.35rem;
		font-weight: 500;
		letter-spacing: -0.03em;
	}

	.queue-panel ol {
		display: grid;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.queue-panel li {
		display: grid;
		gap: 0.35rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid rgba(181, 138, 69, 0.24);
	}

	.queue-panel li span {
		color: var(--console-orange);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.queue-panel li strong {
		color: var(--console-paper);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.text-link {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		gap: 0.8rem;
		color: var(--console-orange);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.text-link:hover {
		color: var(--console-ivory);
	}

	.queue-panel .text-link {
		margin-top: 1.2rem;
	}

	.log-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(20rem, 0.55fr);
		gap: 1rem;
	}

	.log-list {
		display: grid;
		border-top: 1px solid var(--console-line);
	}

	.log-entry {
		display: grid;
		grid-template-columns: 6rem minmax(0, 1fr) 5rem;
		gap: 1.25rem;
		align-items: start;
		padding: 1.35rem 0;
		border-bottom: 1px solid var(--console-line);
	}

	.log-entry__marker {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding-top: 0.22rem;
		color: var(--console-orange);
		font-size: 0.65rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.log-entry__marker span {
		width: 0.55rem;
		height: 0.55rem;
		border: 1px solid currentColor;
		border-radius: 50%;
		box-shadow: 0 0 12px rgba(244, 127, 22, 0.35);
	}

	.log-entry h3 {
		font-size: 1.1rem;
		line-height: 1.35;
	}

	.log-entry p {
		max-width: 68ch;
		margin-top: 0.35rem;
		color: var(--console-paper);
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.log-entry > small {
		justify-self: end;
		padding-top: 0.25rem;
		color: var(--console-muted);
		font-size: 0.6rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.transparency-note {
		display: grid;
		align-content: start;
		padding: 1.5rem;
	}

	.transparency-note > * {
		position: relative;
		z-index: 2;
	}

	.transparency-note :global(.icon-sigil) {
		width: 4.5rem;
		height: 4.5rem;
		margin-bottom: 1.4rem;
		color: var(--console-brass);
	}

	.transparency-note h3 {
		margin-top: 0.8rem;
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.9rem, 3vw, 2.6rem);
		font-weight: 500;
		line-height: 1.05;
	}

	.transparency-note > p:not(.section-code) {
		margin-top: 1rem;
		color: var(--console-paper);
		font-size: 0.91rem;
		line-height: 1.65;
	}

	.transparency-note .text-link {
		margin-top: 1.3rem;
	}

	.community {
		display: grid;
		grid-template-columns: minmax(11rem, 0.4fr) minmax(0, 1.05fr) minmax(18rem, 0.65fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: center;
		scroll-margin-top: 7rem;
		padding: clamp(3rem, 7vw, 6rem);
		border: 1px solid rgba(181, 138, 69, 0.62);
		background:
			linear-gradient(105deg, rgba(244, 127, 22, 0.1), transparent 42%),
			rgba(12, 14, 12, 0.95);
		box-shadow: 0 40px 100px rgba(0, 0, 0, 0.34);
	}

	.community__signal {
		position: relative;
		display: grid;
		min-height: 13rem;
		place-items: center;
		border: 1px solid var(--console-line);
		background:
			repeating-conic-gradient(from 210deg at 50% 50%, rgba(181, 138, 69, 0.18) 0 1deg, transparent 1deg 12deg),
			#090b09;
	}

	.community__signal :global(.icon-sigil) {
		width: 6rem;
		height: 6rem;
		color: var(--console-orange);
	}

	.community__signal > span {
		position: absolute;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: var(--console-teal);
		box-shadow: 0 0 14px rgba(123, 201, 196, 0.8);
	}

	.community__signal > span:nth-of-type(1) { top: 15%; left: 20%; }
	.community__signal > span:nth-of-type(2) { top: 25%; right: 16%; }
	.community__signal > span:nth-of-type(3) { right: 26%; bottom: 14%; }

	.community h2 {
		max-width: 13ch;
		margin-top: 0.8rem;
		font-size: clamp(3rem, 5.6vw, 5.8rem);
	}

	.community__copy > p:not(.section-code) {
		max-width: 59ch;
		margin-top: 1.25rem;
		color: var(--console-paper);
		font-size: 1rem;
		line-height: 1.7;
	}

	.community__copy .button {
		margin-top: 1.75rem;
	}

	.community__routes {
		display: grid;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--console-line);
		list-style: none;
	}

	.community__routes li {
		display: grid;
		gap: 0.35rem;
		padding: 1.15rem 0;
		border-bottom: 1px solid var(--console-line);
	}

	.community__routes span {
		color: var(--console-teal);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.community__routes strong {
		color: var(--console-paper);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.about {
		display: grid;
		grid-template-columns: minmax(15rem, 0.52fr) minmax(0, 1.1fr);
		gap: clamp(3rem, 8vw, 9rem);
		align-items: start;
		padding-top: 1.5rem;
		border-top: 1px solid var(--console-line);
	}

	.about__label {
		display: grid;
		justify-items: start;
		gap: 1rem;
		color: var(--console-muted);
		font-size: 0.67rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.about__label :global(.icon-sigil) {
		width: 5.2rem;
		height: 5.2rem;
		color: var(--console-brass);
	}

	.about h2 {
		margin-top: 0.6rem;
	}

	.about__lead {
		max-width: 58ch;
		margin-top: 1.5rem;
		color: var(--console-ivory);
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.35rem, 2.4vw, 2rem);
		line-height: 1.35;
	}

	.about__copy > p:not(.section-code, .about__lead) {
		max-width: 64ch;
		margin-top: 1.2rem;
		color: var(--console-paper);
		font-size: 1rem;
		line-height: 1.75;
	}

	.about__links {
		margin-top: 1.25rem;
		gap: 1.5rem;
	}

	.console-footer {
		display: grid;
		grid-template-columns: minmax(14rem, 1fr) auto minmax(14rem, 1fr);
		gap: 2rem;
		align-items: center;
		padding: 2.25rem 0 3rem;
		border-top: 1px solid var(--console-line);
		color: var(--console-muted);
		font-size: 0.64rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.brand--footer .brand__mark {
		width: 2.3rem;
		height: 2.3rem;
	}

	.console-footer nav,
	.console-footer__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 1.2rem;
	}

	.console-footer nav a,
	.console-footer__meta a {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
	}

	.console-footer a:hover {
		color: var(--console-orange);
	}

	.console-footer__meta {
		justify-content: flex-end;
	}

	.console-footer__meta .console-footer__icon-link {
		width: 44px;
		justify-content: center;
	}

	.console-footer__icon-link :global(.site-icon) {
		font-size: 1.15rem;
	}

	@keyframes signal-pulse {
		0%, 100% { opacity: 0.55; transform: scale(0.78); }
		50% { opacity: 1; transform: scale(1); }
	}

	@keyframes trace-live {
		0%, 100% { opacity: 0.24; transform: scaleX(0.35); }
		45% { opacity: 1; transform: scaleX(1); }
	}

	@keyframes slow-spin {
		to { transform: rotate(360deg); }
	}

	@media (max-width: 1080px) {
		.console-header {
			grid-template-columns: minmax(14rem, 1fr) auto;
		}

		.console-nav {
			grid-column: 1 / -1;
			grid-row: 2;
			border-top: 1px solid rgba(181, 138, 69, 0.18);
		}

		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(22rem, 0.8fr);
			gap: 2rem;
		}

		.hero h1 {
			font-size: clamp(4rem, 8.2vw, 6.8rem);
		}

		.project-board,
		.log-grid {
			grid-template-columns: 1fr;
		}

		.queue-panel {
			min-height: 0;
		}

		.community {
			grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr);
		}

		.community__routes {
			grid-column: 1 / -1;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.community__routes li {
			padding: 1.15rem;
			border-right: 1px solid var(--console-line);
		}

		.console-footer {
			grid-template-columns: 1fr auto;
		}

		.console-footer nav {
			justify-content: flex-end;
		}

		.console-footer__meta {
			grid-column: 1 / -1;
			justify-content: space-between;
			border-top: 1px solid rgba(181, 138, 69, 0.16);
		}
	}

	@media (max-width: 800px) {
		.console-header {
			gap: 0.4rem;
			padding-top: 0.65rem;
		}

		.hero {
			grid-template-columns: 1fr;
			min-height: 0;
			padding-top: 4.8rem;
		}

		.hero__copy {
			max-width: 44rem;
		}

		.command-panel {
			min-height: 0;
		}

		.command-mark {
			width: 7rem;
			height: 7rem;
			margin-block: 1.4rem;
		}

		.command-mark :global(img) {
			width: 4.3rem;
			height: 4.3rem;
		}

		.section-heading,
		.section-heading--compact {
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.section-heading > p {
			justify-self: start;
		}

		.project-card {
			grid-template-columns: 2rem 3.8rem minmax(0, 1fr);
		}

		.project-card__state {
			grid-column: 3;
			justify-items: start;
		}

		.project-card__state small {
			text-align: left;
		}

		.community {
			grid-template-columns: 1fr;
			padding: 2rem;
		}

		.community__signal {
			min-height: 9rem;
		}

		.community__routes {
			grid-column: auto;
			grid-template-columns: 1fr;
		}

		.community__routes li {
			padding-inline: 0;
			border-right: 0;
		}

		.about {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	@media (max-width: 600px) {
		.console-header,
		.console main,
		.console-footer {
			width: min(100% - 1.25rem, 1440px);
		}

		.console-header {
			grid-template-columns: 1fr;
			padding-top: 0.8rem;
		}

		.brand {
			justify-self: center;
		}

		.header-cta {
			grid-row: 3;
			width: 100%;
			justify-self: stretch;
		}

		.console-nav {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			width: 100%;
		}

		.console-nav a {
			justify-content: center;
			padding-inline: 0.25rem;
			font-size: 0.62rem;
			text-align: center;
		}

		.console main {
			gap: 5.25rem;
			padding-bottom: 5.25rem;
		}

		.hero {
			padding: 4rem 0 2.5rem;
		}

		.hero h1 {
			font-size: clamp(3.55rem, 18vw, 5rem);
		}

		.hero__lede {
			font-size: 1rem;
			line-height: 1.65;
		}

		.hero__actions,
		.about__links {
			display: grid;
		}

		.button,
		.about__links .text-link {
			width: 100%;
		}

		.hero__principles {
			display: grid;
		}

		.command-panel {
			padding: 0.8rem;
		}

		.readout > div {
			grid-template-columns: 1fr;
			gap: 0.15rem;
		}

		.readout dd {
			text-align: left;
		}

		.process-rail {
			grid-template-columns: 1fr;
			gap: 0.7rem;
			margin-top: -4.25rem;
		}

		.process-rail ol {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 0.65rem 0;
		}

		.process-rail li {
			min-height: 30px;
		}

		.section-heading h2,
		.community h2,
		.about h2 {
			font-size: clamp(2.9rem, 15vw, 4.2rem);
		}

		.project-card {
			grid-template-columns: 2rem minmax(0, 1fr);
			gap: 0.65rem;
			padding-block: 1.2rem;
		}

		.project-card__icon {
			grid-column: 1;
			grid-row: 2;
		}

		.project-card__icon :global(.icon-sigil) {
			width: 2rem;
			height: 2rem;
