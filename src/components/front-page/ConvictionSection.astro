---
interface Principle {
	reference: string;
	label: string;
	copy: string;
}

interface Props {
	id?: string;
	class?: string;
	title?: string;
	lead?: string;
	principles?: Principle[];
}

const defaultPrinciples: Principle[] = [
	{
		reference: "Proverbs 22:29",
		label: "Diligence",
		copy: "Seest thou a man diligent in his business? he shall stand before kings; he shall not stand before mean men.",
	},
	{
		reference: "Proverbs 16:16",
		label: "Understanding",
		copy: "How much better is it to get wisdom than gold! and to get understanding rather to be chosen than silver!",
	},
	{
		reference: "Romans 2:6–7",
		label: "Doing good",
		copy: "Who will render to every man according to his deeds: To them who by patient continuance in well doing seek for glory and honour and immortality, eternal life:",
	},
];

const defaultProse = [
	"Covenant Foundry is my software studio. My purpose in life is to use my time, talents, and treasures to bring glory to God, and my favorite way to do so is to build useful tools.",
];

const {
	id = "about",
	class: className = "",
	title = "Building for eternity",
	lead = "Hi! I’m Jon.",
	principles = defaultPrinciples,
} = Astro.props;

const titleId = `${id}-title`;
const hasCustomProse = Astro.slots.has("default");
---

<section id={id} class:list={["conviction", className]} aria-labelledby={titleId}>
	<div class="conviction__intro">
		<h2 id={titleId}>{title}</h2>
	</div>

	<div class="conviction__copy">
		{lead && <p class="conviction__lead">{lead}</p>}
		{
			hasCustomProse ? (
				<slot />
			) : (
				defaultProse.map((paragraph) => <p>{paragraph}</p>)
			)
		}
	</div>

	<div class="conviction__principles" aria-label="Stewardship principles">
		{
			principles.map((principle) => (
				<article class="conviction__principle">
					<span>{principle.reference}</span>
					<h3>{principle.label}</h3>
					<p>{principle.copy}</p>
				</article>
			))
		}
	</div>
</section>

<style>
	.conviction {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
		width: min(
			var(--front-page-max, 1440px),
			calc(100% - var(--front-page-pad, clamp(1rem, 4vw, 4.5rem)) * 2)
		);
		column-gap: clamp(3rem, 10vw, 10rem);
		margin-inline: auto;
		padding-bottom: clamp(7rem, 13vw, 12rem);
		color: #f2ecdc;
	}

	.conviction__principle > span {
		font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
		font-weight: 750;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.conviction__intro h2 {
		max-width: 11ch;
		margin: 0;
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(3rem, 5.5vw, 5.8rem);
		font-weight: 500;
		line-height: 0.91;
		letter-spacing: -0.035em;
	}

	.conviction__copy {
		display: grid;
		align-content: start;
		gap: 1rem;
		padding-top: 2.2rem;
	}

	.conviction__copy :global(p) {
		max-width: 56ch;
		margin: 0;
		color: #bdb29e;
		font-size: 1rem;
		line-height: 1.75;
	}

	.conviction__copy .conviction__lead {
		color: #f2ecdc;
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: 1.6rem;
		line-height: 1.2;
	}

	.conviction__principles {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin-top: clamp(3rem, 8vw, 7rem);
		border-top: 1px solid rgba(181, 138, 69, 0.4);
		border-bottom: 1px solid rgba(181, 138, 69, 0.4);
	}

	.conviction__principle {
		min-height: 15rem;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		border-right: 1px solid rgba(181, 138, 69, 0.3);
	}

	.conviction__principle:last-child {
		border-right: 0;
	}

	.conviction__principle > span {
		color: #f47f16;
		font-size: 0.62rem;
	}

	.conviction__principle h3 {
		margin: 3rem 0 0;
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		font-weight: 500;
	}

	.conviction__principle p {
		max-width: 28ch;
		margin: 0.6rem 0 0;
		color: #9c927f;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	@media (max-width: 900px) {
		.conviction {
			grid-template-columns: 1fr;
		}

		.conviction__copy {
			padding-top: 0;
		}
	}

	@media (max-width: 680px) {
		.conviction {
			padding-bottom: 6rem;
		}

		.conviction__intro h2 {
			font-size: clamp(2.7rem, 13vw, 4rem);
		}

		.conviction__principles {
			grid-template-columns: 1fr;
			margin-top: 3.5rem;
		}

		.conviction__principle {
			min-height: 12rem;
			border-right: 0;
			border-bottom: 1px solid rgba(181, 138, 69, 0.3);
		}

		.conviction__principle:last-child {
			border-bottom: 0;
		}

		.conviction__principle h3 {
			margin-top: 2rem;
		}
	}
</style>
