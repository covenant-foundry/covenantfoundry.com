---
interface Props {
	class?: string;
	copyright?: string;
}

const {
	class: className = "",
	copyright = `© ${new Date().getFullYear()} Covenant Foundry`,
} = Astro.props;
---

<footer class:list={["front-page-footer", className]}>
	<small>{copyright}</small>
</footer>

<style>
	.front-page-footer {
		display: flex;
		width: min(
			var(--front-page-max, 1440px),
			calc(100% - var(--front-page-pad, clamp(1rem, 4vw, 4.5rem)) * 2)
		);
		align-items: center;
		margin-inline: auto;
		border-top: 1px solid rgba(181, 138, 69, 0.5);
		color: #9c927f;
	}

	.front-page-footer small {
		color: #9c927f;
		font: 650 0.62rem/1.2 ui-monospace, "SFMono-Regular", Consolas, monospace;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

</style>
