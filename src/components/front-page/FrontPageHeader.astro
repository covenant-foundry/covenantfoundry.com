---
import SiteIcon, { type SiteIconName } from "../SiteIcon.astro";
import BrandLockup from "./BrandLockup.astro";

export interface FrontPageLink {
	label: string;
	href: string;
	external?: boolean;
	current?: boolean;
	icon?: Extract<SiteIconName, "discord" | "github">;
}

interface Props {
	class?: string;
	brandHref?: string;
	brandName?: string;
	descriptor?: string;
	links?: FrontPageLink[];
	skipLabel?: string;
}

const defaultLinks: FrontPageLink[] = [
	{ label: "Projects", href: "/projects", current: Astro.url.pathname.startsWith("/projects") },
	{ label: "Community", href: "/#community" },
	{ label: "About", href: "/#about" },
	{ label: "GitHub", href: "https://github.com/Covenant-Foundry", external: true, icon: "github" },
	{ label: "Discord", href: "https://discord.gg/JcWQNBXH42", external: true, icon: "discord" },
];

const {
	class: className = "",
	brandHref = "#top",
	brandName = "Covenant Foundry",
	descriptor = "Software studio & builder community",
	links = defaultLinks,
	skipLabel = "Skip to main content",
} = Astro.props;

const isExternalLink = (link: FrontPageLink) =>
	link.external ?? /^(?:https?:)?\/\//.test(link.href);
---

<a class="front-page-skip" href="#main-content">{skipLabel}</a>

<header class:list={["front-page-header", className]}>
	<BrandLockup
		class="front-page-header__brand"
		href={brandHref}
		name={brandName}
		tagline={descriptor}
	/>

	<nav class="front-page-nav" aria-label="Primary navigation">
		{
			links.map((link) => {
				const external = isExternalLink(link);
				return (
					<a
						class:list={[link.icon && "front-page-nav__icon-link"]}
						href={link.href}
						target={external ? "_blank" : undefined}
						rel={external ? "noopener noreferrer" : undefined}
						aria-current={link.current ? "page" : undefined}
						aria-label={link.icon ? link.label : undefined}
						title={link.icon ? link.label : undefined}
					>
						{link.icon ? <SiteIcon name={link.icon} /> : link.label}
						{external && !link.icon && <SiteIcon name="external-link" />}
					</a>
				);
			})
		}
	</nav>
</header>

<style>
	.front-page-skip {
		position: fixed;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 100;
		padding: 0.8rem 1rem;
		background: #f2ecdc;
		color: #080807;
		font: 750 0.72rem/1 ui-monospace, "SFMono-Regular", Consolas, monospace;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		transform: translateY(calc(-100% - 1rem));
		transition: transform 140ms ease;
	}

	.front-page-skip:focus-visible {
		outline: 2px solid #f47f16;
		outline-offset: 3px;
		transform: translateY(0);
	}

	.front-page-header {
		display: flex;
		width: min(
			var(--front-page-max, 1440px),
			calc(100% - var(--front-page-pad, clamp(1rem, 4vw, 4.5rem)) * 2)
		);
		min-height: 76px;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		margin-inline: auto;
		border-bottom: 1px solid rgba(181, 138, 69, 0.46);
	}

	.front-page-nav,
	.front-page-nav a {
		display: flex;
		align-items: center;
	}

	.front-page-nav :global(.site-icon) {
		font-size: 0.9rem;
	}

	.front-page-nav {
		flex-wrap: wrap;
		gap: clamp(0.2rem, 1vw, 0.8rem);
	}

	.front-page-nav a {
		position: relative;
		min-height: 44px;
		gap: 0.35rem;
		padding-inline: 0.8rem;
		color: #d8cdb8;
		font: 700 0.72rem/1 ui-monospace, "SFMono-Regular", Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.front-page-nav a::after {
		position: absolute;
		right: 0.8rem;
		bottom: 0.35rem;
		left: 0.8rem;
		height: 1px;
		background: #f47f16;
		content: "";
		transform: scaleX(0);
		transition: transform 160ms ease;
	}

	.front-page-nav .front-page-nav__icon-link {
		width: 44px;
		justify-content: center;
		padding: 0;
	}

	.front-page-nav__icon-link :global(.site-icon) {
		font-size: 1.2rem;
	}

	.front-page-nav a:hover::after,
	.front-page-nav a:focus-visible::after,
	.front-page-nav a[aria-current="page"]::after {
		transform: scaleX(1);
	}

	.front-page-nav a:focus-visible {
		outline: 2px solid #f47f16;
		outline-offset: 4px;
	}

	@media (max-width: 900px) {
		.front-page-header {
			gap: 1rem;
		}

	}

	@media (max-width: 680px) {
		.front-page-header {
			flex-wrap: wrap;
			gap: 0;
			padding-top: 0.35rem;
		}

		.front-page-header :global(.front-page-header__brand) {
			width: 100%;
			justify-content: center;
		}

		.front-page-nav {
			width: 100%;
			justify-content: center;
		}

		.front-page-nav a {
			padding-inline: 0.55rem;
			font-size: 0.67rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.front-page-skip,
		.front-page-nav a::after {
			transition-duration: 0.001ms;
		}
	}
</style>
