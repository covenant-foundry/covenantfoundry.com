---
import ProjectDossiers from "./ProjectDossiers.astro";
import type { ProjectDossier } from "../../lib/content";

interface Props {
	id?: string;
	projects: ProjectDossier[];
}

const {
	id = "projects",
	projects,
} = Astro.props;
---

<section id={id} class="projects-list" aria-labelledby={`${id}-title`}>
	<h2 id={`${id}-title`} class="projects-list__title">Projects</h2>
	<ProjectDossiers projects={projects} />
</section>

<style>
	.projects-list {
		width: min(
			var(--front-page-max, 1440px),
			calc(100% - var(--front-page-pad, clamp(1rem, 4vw, 4.5rem)) * 2)
		);
		margin-inline: auto;
		padding-block: clamp(2rem, 4vw, 3.5rem) clamp(6rem, 11vw, 10rem);
	}

	.projects-list__title {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		clip-path: inset(50%);
		white-space: nowrap;
	}

	@media (max-width: 680px) {
		.projects-list {
			padding-top: 2rem;
		}
	}
</style>
