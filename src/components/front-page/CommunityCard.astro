---
import IconSigil from "../IconSigil.astro";
import OrnateButton from "../OrnateButton.astro";

interface Props {
	id?: string;
	class?: string;
	title?: string;
	description?: string;
	activities?: string[];
	ctaLabel?: string;
	ctaHref?: string;
}

const defaultActivities = [
	"Discuss decisions as Christians",
	"Share your progress and get feedback",
	"Encourage one another and celebrate together",
];

const {
	id = "community",
	class: className = "",
	title = "Build beside people who share your purpose.",
	description =
		"The Covenant Foundry Discord is a community for Christian builders and founders.",
	activities = defaultActivities,
	ctaLabel = "Join the community",
	ctaHref = "https://discord.gg/JcWQNBXH42",
} = Astro.props;

const titleId = `${id}-title`;
---

<section id={id} class:list={["community-card", className]} aria-labelledby={titleId}>
	<div class="community-card__ornament" aria-hidden="true">
		<span></span>
		<div><IconSigil name="community" /></div>
		<span></span>
	</div>

	<div class="community-card__body">
		<h2 id={titleId}>{title}</h2>
		<p class="community-card__lede">{description}</p>
		<ul class="community-card__list" aria-label="Community activities">
			{
				activities.map((activity, index) => (
					<li>
						<span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
						{activity}
					</li>
				))
			}
		</ul>
		<OrnateButton
			class="community-card__cta"
			href={ctaHref}
			target="_blank"
			rel="noopener noreferrer"
			ariaLabel={`${ctaLabel} (opens in a new tab)`}
		>
			{ctaLabel} <span aria-hidden="true">↗</span>
		</OrnateButton>
	</div>
</section>

<style>
	.community-card {
		--community-brass: #b58a45;
		--community-brass-bright: #d3a763;
		--community-orange: #f47f16;
		--community-ivory: #f2ecdc;
		position: relative;
		width: min(
			1260px,
			calc(100% - var(--front-page-pad, clamp(1rem, 4vw, 4.5rem)) * 2)
		);
		margin: 0 auto clamp(7rem, 13vw, 12rem);
		padding: clamp(2.5rem, 7vw, 6.5rem);
		border: 1px solid rgba(181, 138, 69, 0.74);
		background:
			linear-gradient(135deg, rgba(181, 138, 69, 0.1), transparent 38%),
			radial-gradient(circle at 75% 20%, rgba(244, 127, 22, 0.11), transparent 26rem),
			rgba(11, 13, 12, 0.94);
		box-shadow: 0 35px 110px rgba(0, 0, 0, 0.42);
	}

	.community-card::before,
	.community-card::after {
		position: absolute;
		width: 2.5rem;
		height: 2.5rem;
		content: "";
		pointer-events: none;
	}

	.community-card::before {
		top: 9px;
		left: 9px;
		border-top: 2px solid var(--community-orange);
		border-left: 2px solid var(--community-orange);
	}

	.community-card::after {
		right: 9px;
		bottom: 9px;
		border-right: 2px solid var(--community-orange);
		border-bottom: 2px solid var(--community-orange);
	}

	.community-card__ornament {
		display: grid;
		grid-template-columns: minmax(2rem, 1fr) auto minmax(2rem, 1fr);
		align-items: center;
		gap: 1.5rem;
		margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
	}

	.community-card__ornament > span {
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(181, 138, 69, 0.75));
	}

	.community-card__ornament > span:last-child {
		background: linear-gradient(90deg, rgba(181, 138, 69, 0.75), transparent);
	}

	.community-card__ornament > div {
		width: 5rem;
		color: var(--community-brass-bright);
	}

	.community-card__ornament :global(.icon-sigil) {
		display: block;
		width: 100%;
	}

	.community-card__body {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.65fr);
		column-gap: clamp(3rem, 8vw, 8rem);
	}

	.community-card h2 {
		grid-column: 1;
		max-width: 13ch;
		margin: 1rem 0 0;
		color: var(--community-ivory);
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(3rem, 5.3vw, 5.8rem);
		font-weight: 500;
		line-height: 0.92;
		letter-spacing: -0.035em;
	}

	.community-card__lede,
	.community-card__list {
		grid-column: 2;
	}

	.community-card__lede {
		grid-row: 1 / span 2;
		align-self: end;
		margin: 0;
		color: #c7bca8;
		font-size: clamp(1rem, 1.3vw, 1.15rem);
		line-height: 1.7;
	}

	.community-card__list {
		display: grid;
		gap: 0;
		margin: clamp(2rem, 4vw, 3rem) 0 0;
		padding: 0;
		list-style: none;
	}

	.community-card__list li {
		display: grid;
		grid-template-columns: 2.25rem 1fr;
		min-height: 52px;
		align-items: center;
		border-top: 1px solid rgba(181, 138, 69, 0.28);
		color: #d8cdb8;
		font-size: 0.9rem;
	}

	.community-card__list li:last-child {
		border-bottom: 1px solid rgba(181, 138, 69, 0.28);
	}

	.community-card__list li span {
		color: var(--community-orange);
		font: 750 0.62rem/1 ui-monospace, "SFMono-Regular", Consolas, monospace;
	}

	.community-card :global(.community-card__cta.ornate-button) {
		grid-column: 1 / -1;
		width: min(100%, 31rem);
		height: clamp(3.25rem, 7vw, 4.5rem);
		min-height: 52px;
		margin-top: 1.5rem;
		aspect-ratio: auto;
		justify-self: center;
	}

	.community-card :global(.community-card__cta .ornate-button__label) {
		font-size: clamp(0.66rem, 0.9vw, 0.82rem);
		letter-spacing: 0.035em;
	}

	@media (max-width: 900px) {
		.community-card__body {
			grid-template-columns: 1fr;
		}

		.community-card h2,
		.community-card__lede,
		.community-card__list {
			grid-column: 1;
		}

		.community-card :global(.community-card__cta.ornate-button) {
			grid-column: 1 / -1;
		}

		.community-card__lede {
			grid-row: auto;
			margin-top: 1.5rem;
		}
	}

	@media (max-width: 680px) {
		.community-card {
			padding: 3.5rem 1.5rem 2.25rem;
		}

		.community-card__ornament {
			gap: 0.75rem;
		}

		.community-card__ornament > div {
			width: 4rem;
		}

		.community-card h2 {
			font-size: clamp(2.7rem, 13vw, 4rem);
		}

		.community-card__list li {
			grid-template-columns: 2rem 1fr;
			padding-block: 0.75rem;
			line-height: 1.45;
		}

		.community-card :global(.community-card__cta.ornate-button) {
			width: 100%;
			height: 3.5rem;
		}
	}
</style>
