---
import SiteIcon from "../SiteIcon.astro";
import DevlogList from "../DevlogList.astro";
import ProjectFacts from "../ProjectFacts.astro";
import type { ProjectDossier } from "../../lib/content";

interface Props {
	projects: ProjectDossier[];
}

const { projects } = Astro.props;
---

<div class="dossiers" role="group" aria-label="Project dossiers">
	<div class:list={["dossiers__grid", projects.length === 2 && "dossiers__grid--two"]}>
		{
			projects.map((project) => (
				<article class:list={["dossier", `dossier--${project.statusTone}`]}>
					<div class="dossier__identity">
						<h3>{project.name}</h3>
						{project.productionHref ? (
							<a href={project.productionHref} target="_blank" rel="noopener noreferrer">
								{project.domain}
								<SiteIcon name="external-link" />
							</a>
						) : (
							<p>{project.domain}</p>
						)}
					</div>

					<p class="dossier__description">{project.description}</p>
					<a class="dossier__details" href={project.detailHref}>
						Project details <span aria-hidden="true">→</span>
					</a>

					<ProjectFacts
						status={project.status}
						statusTone={project.statusTone}
						support={project.support}
						supportHref={project.supportHref}
						variant="card"
					/>

					<DevlogList
						entries={project.log.map((entry) => ({
							...entry,
							ariaLabel: `${entry.title} — ${project.name} dev log entry`,
						}))}
						entryCount={project.devlogCount}
						headingId={`${project.slug}-build-log`}
						titleHref={`${project.detailHref}#devlog`}
						emptyMessage="The first dev log entry is still being prepared."
						variant="card"
					/>
				</article>
			))
		}
	</div>
</div>

<style>
	.dossiers {
		--dossier-brass: #b58a45;
		--dossier-brass-bright: #d3a763;
		--dossier-orange: #f47f16;
		--dossier-ivory: #f2ecdc;
		--dossier-parchment: #d8cdb8;
		--dossier-muted: #9c927f;
		position: relative;
		width: 100%;
	}

	.dossiers__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1px;
		padding: 1px;
		background: rgba(181, 138, 69, 0.36);
		box-shadow: 0 34px 100px rgba(0, 0, 0, 0.28);
	}

	.dossiers__grid--two {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.dossier {
		--status-color: var(--dossier-orange);
		position: relative;
		display: grid;
		grid-template-rows: auto minmax(8.5rem, auto) auto auto 1fr;
		min-width: 0;
		padding: clamp(1.15rem, 2.2vw, 2rem);
		background:
			linear-gradient(135deg, rgba(181, 138, 69, 0.09), transparent 24%),
			linear-gradient(180deg, #10120f, #0a0b0a 68%);
		isolation: isolate;
	}

	.dossier--live {
		--status-color: #73bbb8;
	}

	.dossier--pilot {
		--status-color: #f47f16;
	}

	.dossier--planned,
	.dossier--paused {
		--status-color: #9c927f;
	}

	.dossier::before,
	.dossier::after {
		position: absolute;
		z-index: -1;
		content: "";
		pointer-events: none;
	}

	.dossier::before {
		top: 0;
		left: 50%;
		width: 38%;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--status-color), transparent);
		box-shadow: 0 0 16px color-mix(in srgb, var(--status-color) 30%, transparent);
		transform: translateX(-50%);
	}

	.dossier::after {
		inset: 0.55rem;
		border: 1px solid rgba(181, 138, 69, 0.09);
		clip-path: polygon(
			0 1rem,
			1rem 1rem,
			1rem 0,
			calc(100% - 1rem) 0,
			calc(100% - 1rem) 1rem,
			100% 1rem,
			100% calc(100% - 1rem),
			calc(100% - 1rem) calc(100% - 1rem),
			calc(100% - 1rem) 100%,
			1rem 100%,
			1rem calc(100% - 1rem),
			0 calc(100% - 1rem)
		);
	}

	.dossier__details {
		font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
		font-weight: 750;
		letter-spacing: 0.075em;
		text-transform: uppercase;
	}

	.dossier__identity {
		padding-top: clamp(0.8rem, 1.5vw, 1.4rem);
	}

	.dossier__identity h3 {
		margin: 0;
		color: var(--dossier-ivory);
		font-family: "Iowan Old Style", Baskerville, Georgia, serif;
		font-size: clamp(2rem, 3.2vw, 3.15rem);
		font-weight: 500;
		line-height: 0.95;
		letter-spacing: -0.035em;
	}

	.dossier__identity p,
	.dossier__identity a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-top: 0.65rem;
		color: var(--dossier-brass-bright);
		font: 700 0.66rem/1.25 ui-monospace, "SFMono-Regular", Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.dossier__identity a:hover {
		color: var(--dossier-orange);
	}

	.dossier__identity :global(.site-icon) {
		width: 0.8rem;
		height: 0.8rem;
	}

	.dossier__description {
		max-width: 42ch;
		padding-top: 1.25rem;
		color: #bdb29e;
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.dossier__details {
		display: inline-flex;
		width: fit-content;
		align-items: center;
		gap: 0.55rem;
		margin: -0.75rem 0 1.25rem;
		color: var(--dossier-parchment);
		font-size: 0.62rem;
		line-height: 1.2;
	}

	.dossier__details span {
		color: var(--dossier-orange);
		font-size: 0.8rem;
	}

	.dossier__details:hover {
		color: var(--dossier-ivory);
	}

	.dossier__identity a:focus-visible,
	.dossier__details:focus-visible {
		outline: 2px solid var(--dossier-orange);
		outline-offset: 3px;
	}

	@media (max-width: 1100px) {
		.dossiers__grid {
			grid-template-columns: 1fr;
		}

		.dossier {
			grid-template-rows: auto;
		}

		.dossier__description {
			min-height: 0;
			padding-bottom: 1.5rem;
		}

	}

	@media (max-width: 520px) {
		.dossier {
			padding: 1rem;
		}

		.dossier__identity {
			padding-top: 1rem;
		}

		.dossier__identity h3 {
			font-size: 2.35rem;
		}

		.dossier__description {
			font-size: 0.86rem;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.dossier__identity a,
		.dossier__details {
			transition: none;
		}
	}
</style>
