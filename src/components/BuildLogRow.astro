---
interface Props {
	date: string;
	title: string;
	summary: string;
	meta?: string;
}

const { date, title, summary, meta = "5 min read" } = Astro.props;
---

<article class="build-row">
	<time>{date}</time>
	<div class="build-node" aria-hidden="true"></div>
	<div>
		<h3>{title}</h3>
		<p>{summary}</p>
	</div>
	<a href="#project-detail">{meta} -></a>
</article>
